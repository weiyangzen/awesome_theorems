{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-theorems.invalid/stage5-1-organization/schemas/current-release.schema.json",
  "title": "Stage5.1 current organization release pointer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "organization_release", "blueprint_revision",
    "base_catalog_release", "not_catalog_release_5_1", "manifest", "subject_id_registry",
    "blueprints", "migration", "activation", "authority_sha256"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "organization_release": {"$ref": "common.schema.json#/$defs/organization_release"},
    "blueprint_revision": {"$ref": "common.schema.json#/$defs/blueprint_revision"},
    "base_catalog_release": {"$ref": "common.schema.json#/$defs/base_catalog_release"},
    "not_catalog_release_5_1": {"const": true},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "authority_sha256"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/repo_path"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "authority_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "subject_id_registry": {"$ref": "#/$defs/registry_binding"},
    "blueprints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theorems", "conjectures"],
      "properties": {
        "theorems": {"$ref": "#/$defs/blueprint_binding"},
        "conjectures": {"$ref": "#/$defs/blueprint_binding"}
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "authority_sha256"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/repo_path"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "authority_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": {"const": "blocked"},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "authority_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  },
  "$defs": {
    "registry_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "rows"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/repo_path"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 1}
      }
    },
    "blueprint_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "gantt_path", "gantt_sha256"],
      "properties": {
        "path": {"$ref": "common.schema.json#/$defs/repo_path"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "gantt_path": {"$ref": "common.schema.json#/$defs/repo_path"},
        "gantt_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}
