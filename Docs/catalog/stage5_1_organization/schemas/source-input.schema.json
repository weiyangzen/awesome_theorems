{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesome-theorems.invalid/stage5-1-organization/schemas/source-input.schema.json",
  "title": "Stage5.1 source input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "organization_release",
    "blueprint_revision",
    "base_catalog_release",
    "not_catalog_release_5_1",
    "inputs",
    "counts",
    "input_root_sha256",
    "authority_sha256"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "organization_release": {"$ref": "common.schema.json#/$defs/organization_release"},
    "blueprint_revision": {"$ref": "common.schema.json#/$defs/blueprint_revision"},
    "base_catalog_release": {"$ref": "common.schema.json#/$defs/base_catalog_release"},
    "not_catalog_release_5_1": {"const": true},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256", "size_bytes"],
        "properties": {
          "role": {
            "enum": [
              "catalog_current_release",
              "catalog_release_manifest",
              "theorem_projection",
              "claim_catalog",
              "stage5_claim_registry",
              "strict_conjecture_ledger",
              "pool_current_release",
              "pool_manifest",
              "pool_occurrences",
              "pool_identity_registry",
              "theorem_blueprint",
              "theorem_gantt",
              "theorem_workset",
              "conjecture_blueprint",
              "conjecture_gantt",
              "conjecture_workset",
              "predecessor_evidence"
            ]
          },
          "path": {"$ref": "common.schema.json#/$defs/repo_path"},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "url": {"type": "string", "format": "uri"},
          "license": {"type": "string", "minLength": 1}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {"type": "integer", "minimum": 0}
      },
      "minProperties": 1
    },
    "input_root_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "authority_sha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
