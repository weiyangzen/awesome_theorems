  "required": [
    "content_digest_before_self_field",
    "counts",
    "extraction_policy",
    "generator",
    "records",
    "rights",
    "schema_version",
    "source_snapshot"
  ],
  "type": "object",
  "$defs": {
    "mapping": {
      "additionalProperties": false,
      "properties": {
        "assistant": {"enum": ["hol_light", "isabelle", "lean", "metamath", "mizar", "rocq"]},
        "authors": {"items": {"type": "string", "minLength": 1}, "type": "array"},
        "comment": {"type": ["string", "null"]},
        "date": {"type": ["string", "null"]},
        "identifiers": {"items": {"type": "string", "minLength": 1}, "type": "array"},
        "library": {"enum": ["L", "S", "X"]},
        "status": {"enum": ["formalized", "statement"]},
        "url": {"format": "uri", "type": "string"}
      },
      "required": ["assistant", "authors", "comment", "date", "identifiers", "library", "status", "url"],
      "type": "object"
    },
    "record": {
      "additionalProperties": false,
      "properties": {
        "external_id": {"pattern": "^Q[1-9][0-9]*(?:[A-Z])?$", "type": "string"},
        "id_suffix": {"enum": ["A", "B", "X", null]},
        "identity_evidence": {
          "additionalProperties": false,
          "properties": {
            "basis": {"const": "listed_in_1000_plus_snapshot_derived_from_wikipedia_list_of_theorems"},
            "independent_universal_importance_ranking_claimed": {"const": false},
            "signal_level": {"const": "encyclopedic_named_theorem_identity"}
          },
          "required": ["basis", "independent_universal_importance_ranking_claimed", "signal_level"],
          "type": "object"
        },
        "msc2020": {"pattern": "^[0-9]{2}$", "type": "string"},
        "proof_assistant_mappings": {"items": {"$ref": "#/$defs/mapping"}, "type": "array"},
        "row_sha256": {"$ref": "#/$defs/sha256"},
        "selection_rank": {"maximum": 1200, "minimum": 1, "type": "integer"},
        "source": {
          "additionalProperties": false,
          "properties": {
            "archive_member": {"pattern": "^1000-plus-8e04b97d/_thm/Q[1-9][0-9]*[A-Z]?\\.md$", "type": "string"},
            "member_sha256": {"$ref": "#/$defs/sha256"},
            "member_size_bytes": {"minimum": 1, "type": "integer"}
          },
          "required": ["archive_member", "member_sha256", "member_size_bytes"],
          "type": "object"
        },
        "source_record_id": {"pattern": "^TP1K-Q[1-9][0-9]*(?:[A-Z])?$", "type": "string"},
        "title": {"minLength": 1, "type": "string"},
        "wikidata_id": {"pattern": "^Q[1-9][0-9]*$", "type": "string"},
        "wikipedia_targets": {
          "items": {"$ref": "#/$defs/wikipedia_target"},
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "external_id",
        "id_suffix",
        "identity_evidence",
        "msc2020",
        "proof_assistant_mappings",
        "row_sha256",
        "selection_rank",
        "source",
        "source_record_id",
        "title",
        "wikidata_id",
        "wikipedia_targets"
      ],
      "type": "object"
    },
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "wikipedia_target": {
      "additionalProperties": false,
      "properties": {
        "display_text": {"type": ["string", "null"]},
        "fragment": {"type": ["string", "null"]},
        "raw": {"minLength": 1, "type": "string"},
        "requested_title": {"type": ["string", "null"]},
        "syntax": {"enum": ["invalid_plain_text", "wikilink"]}
      },
      "required": ["display_text", "fragment", "raw", "requested_title", "syntax"],
      "type": "object"
    }
  }
}
