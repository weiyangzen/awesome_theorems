+import Mathlib
+
+/-!
+# S5-CLM-00003486: the Curling Number Conjecture
+
+This file keeps the source definitions of `k` and `S` intact and exposes the
+complete proposition as `Claim`.  The source theorem is intentionally not
+redeclared with a proof here: the pinned source record is an open research
+claim, so a target-local package must not turn the source assertion into an
+unreviewed theorem.
+-/
+
+namespace Arxiv.«0912.2382»
+
+/--
+The curling number.
+
+For a finite sequence `T`, `k T` is the supremum of the repetition counts of a
+nonempty suffix block.  This is the definition used by the pinned source
+declaration; no computational shortcut is substituted in the statement.
+-/
+noncomputable def k (S : List ℤ) : ℕ :=
+  sSup {k : ℕ | ∃ X Y : List ℤ, Y ≠ [] ∧ S = X ++ (List.replicate k Y).flatten}
+
+/-- The sequence obtained by repeatedly appending its curling number. -/
+noncomputable def S (S₀ : List ℤ) (n : ℕ) : List ℤ :=
+  match n with
+  | 0 => S₀
+  | n + 1 => (S S₀ n) ++ [Int.ofNat (k (S S₀ n))]
+
+/-- The complete source proposition, with all binders made explicit. -/
+def SourceStatement : Prop :=
+  ∀ (S₀ : List ℤ), S₀ ≠ [] → ∃ m, k (S S₀ m) = 1
+
+/-- Canonical target name used by the Stage5 resolution receipts. -/
+def Claim : Prop := SourceStatement
+
+theorem claim_iff_source : Claim ↔ SourceStatement := Iff.rfl
+
+end Arxiv.«0912.2382»
