+/-
+Target-local checked lemmas for S5-CLM-00003486.
+
+The global assertion remains open.  These declarations are deliberately
+limited to exact finite/special-case consequences of the frozen definitions;
+none is presented as a resolution of `Claim`.
+-/
+
+import AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003486.Statement
+
+namespace Arxiv.«0912.2382»
+
+private def repetitionSet (a : ℤ) : Set ℕ :=
+  {r : ℕ | ∃ X Y : List ℤ, Y ≠ [] ∧ [a] = X ++ (List.replicate r Y).flatten}
+
+lemma singleton_repetition_set_nonempty (a : ℤ) :
+    (repetitionSet a).Nonempty := by
+  refine ⟨1, ?_⟩
+  refine ⟨[], [a], by simp, ?_⟩
+  simp
+
+lemma singleton_repetition_set_bounded (a : ℤ) :
+    ∀ r ∈ repetitionSet a, r ≤ 1 := by
+  intro r hr
+  rcases hr with ⟨X, Y, hY, heq⟩
+  have hlen := congrArg List.length heq
+  simp [List.length_append, List.length_flatten] at hlen
+  have hypos : 0 < Y.length := List.ne_nil_iff_length_pos.mp hY
+  have hprod : r * Y.length ≤ 1 := by omega
+  by_contra hnot
+  have hr2 : 2 ≤ r := by omega
+  have hy1 : 1 ≤ Y.length := by omega
+  have htwo : 2 ≤ r * Y.length := by
+    calc
+      2 = 2 * 1 := by norm_num
+      _ ≤ r * Y.length := Nat.mul_le_mul hr2 hy1
+  omega
+
+lemma curling_number_singleton (a : ℤ) : k [a] = 1 := by
+  change sSup (repetitionSet a) = 1
+  have hne := singleton_repetition_set_nonempty a
+  have hbound : BddAbove (repetitionSet a) :=
+    ⟨1, singleton_repetition_set_bounded a⟩
+  have hone : (1 : ℕ) ∈ repetitionSet a := by
+    refine ⟨[], [a], by simp, ?_⟩
+    simp
+  have hlow : 1 ≤ sSup (repetitionSet a) := le_csSup hbound hone
+  have hupp : sSup (repetitionSet a) ≤ 1 :=
+    singleton_repetition_set_bounded a _ (Nat.sSup_mem hne hbound)
+  omega
+
+lemma sequence_nonempty (S₀ : List ℤ) (hS₀ : S₀ ≠ []) :
+    ∀ n, S S₀ n ≠ [] := by
+  intro n
+  induction n with
+  | zero => exact hS₀
+  | succ n ih => simp [S, ih]
+
+lemma singleton_seed_reaches_one (a : ℤ) :
+    ∃ m, k (S [a] m) = 1 := by
+  refine ⟨0, ?_⟩
+  simpa [S] using curling_number_singleton a
+
+end Arxiv.«0912.2382»
