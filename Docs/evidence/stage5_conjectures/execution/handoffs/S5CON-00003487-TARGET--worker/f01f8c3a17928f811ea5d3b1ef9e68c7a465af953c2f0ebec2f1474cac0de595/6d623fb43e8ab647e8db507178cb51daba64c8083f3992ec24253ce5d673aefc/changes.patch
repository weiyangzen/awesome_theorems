+import Mathlib
+import AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003487.Statement
+
+namespace AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003487
+
+open CunninghamChain
+
+def exploredBound : ℕ := 10000
+
+def chainTerms (p k : ℕ) : List ℕ :=
+  (List.range (k + 1)).map (firstKindTerm p)
+
+def boundedExactChain (p k : ℕ) : Prop :=
+  0 < k ∧ p ≤ exploredBound ∧
+    (∀ i < k, (firstKindTerm p i).Prime) ∧
+    ¬ (firstKindTerm p k).Prime
+
+example : firstKindTerm 2 0 = 2 := rfl
+example : firstKindTerm 2 5 = 95 := by norm_num [firstKindTerm]
+example : boundedExactChain 2 5 := by
+  refine ⟨by norm_num, by norm_num [exploredBound], ?_, ?_⟩
+  · intro i hi
+    interval_cases i <;> norm_num [firstKindTerm]
+  · norm_num [firstKindTerm]
+
+def explorationConclusion : String :=
+  "bounded enumeration is evidence only; no infinitude or finiteness conclusion"
+
+end AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003487
