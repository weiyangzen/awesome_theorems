+import Mathlib
+
+/-!
+Exact target-local formalization of the frozen
+Arxiv 1601.03081 crystal-components statement.
+
+The source predicate is copied verbatim at the target boundary. The
+conjecture itself remains an open proposition: this file only provides
+definitional transport and the checked finite source example.
+-/
+
+namespace Arxiv.«1601.03081»
+
+/-- A crystal with components a,b, using the source divisibility test. -/
+def IsCrystalWithComponents (n a b : ℕ) : Prop :=
+  Odd n ∧ 1 < a ∧ 1 < b ∧ n = a * b ∧
+    2 * (a + 1) * (b + 1) ∣ (a + b)^2 + (a * b + 1)^2
+
+theorem isCrystalWithComponents_35_5_7 :
+    IsCrystalWithComponents 35 5 7 := by
+  norm_num [IsCrystalWithComponents]
+
+end Arxiv.«1601.03081»
+
+namespace AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003490
+
+open Arxiv.«1601.03081»
+
+/-- The exact source proposition, with all source binders retained. -/
+abbrev SourceStatement : Prop :=
+  ∀ (n a b c d : ℕ),
+    IsCrystalWithComponents n a b →
+      IsCrystalWithComponents n c d →
+        ({a, b} : Finset ℕ) = {c, d}
+
+/-- Target naming is definitionally identical to the source proposition. -/
+abbrev Target : Prop := SourceStatement
+
+theorem source_to_target : SourceStatement ↔ Target := Iff.rfl
+
+theorem target_to_source : Target ↔ SourceStatement := Iff.rfl
+
+def statementFingerprint : String :=
+  "a6393ffbbf7cf2a3703467474157f3f4eafdd58540606b3f87adce3b936aea19"
+
+end AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003490
