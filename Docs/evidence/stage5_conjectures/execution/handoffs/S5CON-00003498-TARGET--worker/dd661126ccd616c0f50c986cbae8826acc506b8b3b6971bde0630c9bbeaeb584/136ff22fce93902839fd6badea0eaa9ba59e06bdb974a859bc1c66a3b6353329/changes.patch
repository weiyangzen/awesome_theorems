+import Mathlib
+import AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003498.Statement
+import AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003498.Proof
+
+/-!
+# Finite exploration surface for S5-CLM-00003498
+
+The companion search enumerates small numerical parameter tuples satisfying
+the parity and isolate-free premises.  They are sanity checks for the
+arithmetic shape of the source inequality, not a replacement for graph
+definitions and not evidence for the universal Claim.
+-/
+
+namespace Arxiv.«2107.00295»
+
+structure FiniteParameterCase where
+  degree : ℕ
+  independent : ℕ
+  vertices : ℕ
+
+def finiteParameterBound : ℕ := 8
+
+def exploredCases : List FiniteParameterCase :=
+  [ ⟨2, 1, 2⟩
+  , ⟨2, 1, 3⟩
+  , ⟨2, 2, 4⟩
+  , ⟨4, 1, 5⟩
+  , ⟨4, 2, 8⟩
+  , ⟨6, 2, 9⟩
+  ]
+
+def caseSatisfiesBound (c : FiniteParameterCase) : Prop :=
+  Even c.degree → (c.degree + 2)^2 * c.independent ≤
+    (c.degree^2 + 4) * c.vertices
+
+example : caseSatisfiesBound ⟨2, 1, 2⟩ := by
+  intro hEven
+  norm_num
+
+example : caseSatisfiesBound ⟨2, 2, 4⟩ := by
+  intro hEven
+  norm_num
+
+example : exploredCases.length = 6 := by rfl
+
+def explorationConclusion : String :=
+  "six bounded parameter cases satisfy the even-degree arithmetic bound; " ++
+    "finite evidence does not close the universal graph Claim"
+
+end Arxiv.«2107.00295»
+
