+import Mathlib
+
+/-!
+# S5-CLM-00003498: independent domination, even maximum degree
+
+The pinned source declaration is a research statement whose body contains
+`sorryAx`.  This target-local file transports the proposition and the
+source-level quantities, but deliberately does not import or redeclare the
+source theorem as a proof.  `GraphData` is the smallest local interface for
+the three numerical graph invariants occurring in the declaration; it keeps
+the proposition executable in an isolated target checkout while retaining the
+source expression verbatim in the documentation and crosswalk receipts.
+-/
+
+namespace Arxiv.«2107.00295»
+
+/- A finite graph interface exposing exactly the invariants used by the claim. -/
+structure GraphData (V : Type*) where
+  minDegree : ℕ
+  maxDegree : ℕ
+  indepDominationNumber : ℕ
+
+/- The proposition for one fixed graph, with the source hypothesis names. -/
+def SourceStatementFor {V : Type*} [Fintype V] (G : GraphData V) : Prop :=
+  (hIso : 0 < G.minDegree) → (hEven : Even G.maxDegree) →
+    let D := G.maxDegree
+    let i := G.indepDominationNumber
+    let n := Fintype.card V
+    (D + 2)^2 * i ≤ (D^2 + 4) * n
+
+/- The fully quantified target root.  The source section variables `V` and
+   `G` are made explicit here so the root has one unambiguous type. -/
+def SourceStatement : Prop :=
+  ∀ {V : Type} [Fintype V] (G : GraphData V), SourceStatementFor G
+
+def Claim : Prop := SourceStatement
+
+theorem claim_iff_source : Claim ↔ SourceStatement := Iff.rfl
+
+/- The exact source declaration body, retained as a readable audit anchor. -/
+def sourceDeclarationText : String :=
+  "theorem independentDominationEven (hIso : 0 < G.minDegree) " ++
+    "(hEven : Even G.maxDegree) : let D := G.maxDegree; " ++
+    "let i := G.indepDominationNumber; let n := Fintype.card V; " ++
+    "(D + 2)^2 * i ≤ (D^2 + 4) * n"
+
+def statementFingerprint : String :=
+  "bbfc9ecaca2c50de4f3a8d8ab32fd1640351f5946b8790bbc1e9894c952e46b4"
+
+end Arxiv.«2107.00295»
