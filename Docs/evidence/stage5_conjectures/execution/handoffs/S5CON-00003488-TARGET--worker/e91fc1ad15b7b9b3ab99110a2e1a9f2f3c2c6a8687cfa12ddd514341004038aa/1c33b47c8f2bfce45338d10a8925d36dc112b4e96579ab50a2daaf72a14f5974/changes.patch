+import Mathlib
+import AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003488.Statement
+
+namespace AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003488
+
+open CunninghamChain
+
+def exploredBound : ℕ := 10000
+
+def chainTerms (p k : ℕ) : List ℕ :=
+  (List.range (k + 1)).map (secondKindTerm p)
+
+def boundedExactChain (p k : ℕ) : Prop :=
+  0 < k ∧ p ≤ exploredBound ∧
+    (∀ i < k, (secondKindTerm p i).Prime) ∧
+    ¬ (secondKindTerm p k).Prime
+
+example : secondKindTerm 7 0 = 7 := rfl
+example : secondKindTerm 7 1 = 13 := by norm_num [secondKindTerm]
+example : secondKindTerm 7 2 = 25 := by norm_num [secondKindTerm]
+example : boundedExactChain 7 2 := by
+  refine ⟨by norm_num, by norm_num [exploredBound], ?_, ?_⟩
+  · intro i hi
+    interval_cases i <;> norm_num [secondKindTerm]
+  · norm_num [secondKindTerm]
+
+def explorationConclusion : String :=
+  "bounded enumeration is evidence only; no infinitude or finiteness conclusion"
+
+end AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003488
