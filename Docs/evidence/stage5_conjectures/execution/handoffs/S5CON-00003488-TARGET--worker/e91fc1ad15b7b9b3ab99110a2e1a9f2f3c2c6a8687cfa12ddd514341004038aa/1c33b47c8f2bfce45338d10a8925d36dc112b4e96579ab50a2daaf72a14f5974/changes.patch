+import Mathlib
+
+/-!
+Exact target statement for S5-CLM-00003488.
+
+The source declaration is retained as a proposition, while this file supplies
+the target-local names and the bidirectional definitional transport used by
+the crosswalk.  No theorem asserting the open infinitude conjecture is
+introduced here.
+-/
+
+namespace CunninghamChain
+
+/-- The `n`th term generated by the second-kind recurrence `q ↦ 2q - 1`. -/
+def secondKindTerm (p : ℕ) : ℕ → ℕ
+  | 0 => p
+  | n + 1 => 2 * secondKindTerm p n - 1
+
+/-- `p` starts a second-kind Cunningham chain of exact positive length `k`. -/
+def IsSecondKindChainOfLength (p k : ℕ) : Prop :=
+  0 < k ∧ (∀ i < k, (secondKindTerm p i).Prime) ∧
+    ¬ (secondKindTerm p k).Prime
+
+abbrev InfinitelyManySecondKindChains (k : ℕ) (hk : 0 < k) : Prop :=
+  Set.Infinite {p : ℕ | IsSecondKindChainOfLength p k}
+
+end CunninghamChain
+
+namespace AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003488
+
+open CunninghamChain
+
+abbrev SourceStatement (k : ℕ) (hk : 0 < k) : Prop :=
+  Set.Infinite {p : ℕ | IsSecondKindChainOfLength p k}
+
+abbrev Target (k : ℕ) (hk : 0 < k) : Prop := SourceStatement k hk
+
+theorem source_to_target (k : ℕ) (hk : 0 < k) :
+    SourceStatement k hk ↔ Target k hk := Iff.rfl
+
+theorem target_to_source (k : ℕ) (hk : 0 < k) :
+    Target k hk ↔ SourceStatement k hk := Iff.rfl
+
+def statementFingerprint : String :=
+  "6964af575e606d8cd6b2c2a4b25075b2d5694c92f53680397d0ce380f9953e28"
+
+end AwesomeTheorems.Stage5.Conjectures.S5_CLM_00003488
