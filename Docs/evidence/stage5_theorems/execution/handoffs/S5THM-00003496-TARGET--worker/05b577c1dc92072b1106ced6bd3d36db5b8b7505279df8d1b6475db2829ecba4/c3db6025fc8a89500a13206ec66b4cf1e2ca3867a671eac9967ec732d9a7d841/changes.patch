@@ -0,0 +1,37 @@
+import Mathlib
+
+/-!
+# S5-CLM-00003496 — frozen Kotzig large statement
+
+This file is an independent replay of the declaration at the pinned
+`formal-conjectures` revision.  The provider body is deliberately not
+imported: it is a statement source, not proof authority.  In particular, this
+module contains no theorem oracle or claim-specific axiom.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003496
+
+open SimpleGraph
+
+/-- The exact proposition frozen by the Stage 5 workset. -/
+def FrozenStatement : Prop :=
+  ∀ᶠ (n : ℕ) in Filter.atTop, ∀ {V : Type} [Finite V] (T : SimpleGraph V),
+    T.IsTree → T.edgeSet.ncard = n →
+    ∃ f : Fin (2 * n + 1) → (V ↪ Fin (2 * n + 1)),
+      (∀ i v, f i v = f 0 v + i) ∧
+      Pairwise (fun i j => Disjoint (T.map (f i)).edgeSet (T.map (f j)).edgeSet) ∧
+      ⨆ i, T.map (f i) = (⊤ : SimpleGraph (Fin (2 * n + 1)))
+
+/-- Target-facing name; it is definitionally the frozen proposition. -/
+abbrev Target : Prop := FrozenStatement
+
+/-- Forward transport is definitionally identity. -/
+theorem frozen_to_target : FrozenStatement → Target := id
+
+/-- Reverse transport is definitionally identity. -/
+theorem target_to_frozen : Target → FrozenStatement := id
+
+example : FrozenStatement → Target := frozen_to_target
+example : Target → FrozenStatement := target_to_frozen
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003496

