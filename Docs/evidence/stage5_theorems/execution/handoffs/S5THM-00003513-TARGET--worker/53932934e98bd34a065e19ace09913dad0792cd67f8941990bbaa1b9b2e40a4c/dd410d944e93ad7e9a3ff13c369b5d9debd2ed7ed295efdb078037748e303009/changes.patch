+import AwesomeTheorems.Stage5.Theorems.S5_CLM_00003513.Statement
+
+/-!
+# Trust-zero diagnostic proof units
+
+The Huang–Shi theorem is not re-proved in this package.  These declarations
+kernel-check the exact statement transports, the quotient carrier, and the
+characteristic specialization boundary.  They expose the remaining theorem
+as an explicit cut without importing the upstream `sorryAx` declaration or
+introducing a claim-specific oracle.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003513
+
+open Matrix SpecialLinearGroup
+open scoped MatrixGroups Polynomial LaurentSeries
+
+universe u
+
+theorem transport_forward {F : Type u} [Field F] [Fintype F]
+    (h : FrozenStatement F) : Target F :=
+  frozen_to_target h
+
+theorem transport_reverse {F : Type u} [Field F] [Fintype F]
+    (h : Target F) : FrozenStatement F :=
+  target_to_frozen h
+
+theorem quotient_representative_nonempty (F : Type u) [Field F] [Fintype F] :
+    Nonempty (SpecialLinearGroup (Fin 4) (F⸨X⸩) ⧸
+      (Matrix.SpecialLinearGroup.map (polyToLaurent F)).range) :=
+  ⟨QuotientGroup.mk 1⟩
+
+theorem characteristic_specialization {F : Type u} [Field F] [Fintype F]
+    (h : FrozenStatement F)
+    (hchar : ringChar F ∈ ({3, 5, 7, 11} : Finset ℕ)) :
+    OrbitConclusion F :=
+  h hchar
+
+theorem target_characteristic_specialization {F : Type u} [Field F] [Fintype F]
+    (h : Target F)
+    (hchar : ringChar F ∈ ({3, 5, 7, 11} : Finset ℕ)) :
+    OrbitConclusion F :=
+  characteristic_specialization (transport_reverse h) hchar
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003513
