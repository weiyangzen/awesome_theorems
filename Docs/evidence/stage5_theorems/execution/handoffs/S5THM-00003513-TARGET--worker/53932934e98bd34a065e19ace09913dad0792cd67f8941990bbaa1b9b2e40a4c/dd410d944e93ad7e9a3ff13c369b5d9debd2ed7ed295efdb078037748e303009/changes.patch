@@ -0,0 +1,83 @@
+import Mathlib
+
+/-!
+# S5-CLM-00003513 — Margulis/Huang–Shi theorem 1.2
+
+This file freezes the exact proposition from the pinned
+`FormalConjectures.Arxiv.2504.17644.Margulis` record.  The upstream declaration
+is `sorryAx`-bearing, so only its definitions and statement are replayed here;
+no upstream proof body is imported.  The diagonal subgroup notation used by
+the source is reconstructed locally because it is supplied by the
+FormalConjectures-for-Mathlib extension rather than by the pinned Mathlib
+snapshot.
+-/
+
+open Matrix SpecialLinearGroup
+open scoped MatrixGroups Polynomial LaurentSeries
+
+universe u
+
+noncomputable def polyToLaurent (F : Type u) [Field F] : F[X] →+* F⸨X⸩ :=
+  (HahnSeries.ofPowerSeries ℤ F).comp Polynomial.coeToPowerSeries.ringHom
+
+namespace Matrix.GeneralLinearGroup
+
+def diagonalHom (ι R : Type*) [DecidableEq ι] [Fintype ι] [CommRing R] :
+    (ι → Rˣ) →* GeneralLinearGroup ι R where
+  toFun := fun d =>
+    ⟨Matrix.diagonal (fun i => d i), Matrix.diagonal (fun i => (d i).inv),
+      by simp, by simp⟩
+  map_mul' x y := by ext; simp [-mul_diagonal, -diagonal_mul]
+  map_one' := by ext; simp
+
+def diagonalSubgroup (ι R : Type*) [DecidableEq ι] [Fintype ι] [CommRing R] :
+    Subgroup (GeneralLinearGroup ι R) :=
+  Subgroup.map (diagonalHom ι R) ⊤
+
+end Matrix.GeneralLinearGroup
+
+namespace Matrix.SpecialLinearGroup
+
+def diagonalSubgroup (ι R : Type*) [DecidableEq ι] [Fintype ι] [CommRing R] :
+    Subgroup (SpecialLinearGroup ι R) :=
+  (Matrix.GeneralLinearGroup.diagonalSubgroup ι R).comap
+    (SpecialLinearGroup.toGL)
+
+end Matrix.SpecialLinearGroup
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003513
+
+open Matrix SpecialLinearGroup
+
+/-! The source action is on a quotient by the polynomial-to-Laurent subgroup.
+Mathlib supplies the ambient `SL` action, while the source extension supplies
+the subgroup action; this local instance is definitionally that restriction. -/
+noncomputable instance (F : Type u) [Field F] [Fintype F] :
+    SMul (↥(Matrix.SpecialLinearGroup.diagonalSubgroup (Fin 4) (F⸨X⸩)))
+      (SpecialLinearGroup (Fin 4) (F⸨X⸩) ⧸
+        (Matrix.SpecialLinearGroup.map (polyToLaurent F)).range) :=
+  ⟨fun h q => (h.1 : SpecialLinearGroup (Fin 4) (F⸨X⸩)) • q⟩
+
+/-! Exact source proposition, including the characteristic side condition. -/
+abbrev OrbitConclusion (F : Type u) [Field F] [Fintype F] : Prop :=
+  ∃ z : SpecialLinearGroup (Fin 4) (F⸨X⸩) ⧸
+      (Matrix.SpecialLinearGroup.map (polyToLaurent F)).range,
+    IsCompact (closure
+      (MulAction.orbit
+        (Matrix.SpecialLinearGroup.diagonalSubgroup (Fin 4) (F⸨X⸩)) z)) ∧
+      ¬ IsClosed (MulAction.orbit
+        (Matrix.SpecialLinearGroup.diagonalSubgroup (Fin 4) (F⸨X⸩)) z)
+
+set_option linter.unusedVariables false in
+abbrev FrozenStatement (F : Type u) [Field F] [Fintype F] : Prop :=
+  ∀ hchar : ringChar F ∈ ({3, 5, 7, 11} : Finset ℕ), OrbitConclusion F
+
+abbrev Target (F : Type u) [Field F] [Fintype F] : Prop := FrozenStatement F
+
+theorem frozen_to_target {F : Type u} [Field F] [Fintype F] :
+    FrozenStatement F → Target F := fun h => h
+
+theorem target_to_frozen {F : Type u} [Field F] [Fintype F] :
+    Target F → FrozenStatement F := fun h => h
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003513
