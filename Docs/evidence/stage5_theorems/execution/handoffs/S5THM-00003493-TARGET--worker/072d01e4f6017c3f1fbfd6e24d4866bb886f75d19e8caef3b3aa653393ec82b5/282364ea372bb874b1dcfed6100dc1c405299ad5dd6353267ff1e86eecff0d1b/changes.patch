+import AwesomeTheorems.Stage5.Theorems.S5_CLM_00003493.Statement
+
+/-!
+# Local M0-L proof for S5-CLM-00003493
+
+The source type does not require `Ω` to be nonnegative.  We therefore use
+the witness `Ω n = -|iteratedLog n|`.  Its norm is exactly the norm of the
+iterated logarithm, while its exponential is at most one; the elementary
+quadratic bound on `maximalLength` then closes the literal target.  The
+quadratic bound itself is proved by the first-two-coordinate pigeonhole
+argument, including the two small parameter cases.
+
+Copyright (c) 2026 Awesome Theorems contributors.  This target-local
+reconstruction is released under the repository's Apache-2.0 contribution
+terms; no provider proof body is imported.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003493
+
+/-! Equality in the first two coordinates rules out a strict two-coordinate increase. -/
+lemma not_ltTwo_of_first_two_eq {a b : Fin 3 → ℕ}
+    (h0 : a 0 = b 0) (h1 : a 1 = b 1) : ¬ ltTwo a b := by
+  rintro ⟨i, j, hij, hi, hj⟩
+  fin_cases i <;> fin_cases j <;> simp_all
+
+/-! A list longer than the first-two-coordinate grid has a collision. -/
+lemma exists_pair_of_mem_Icc {s : List (Fin 3 → ℕ)} {n : ℕ} (_hn : 2 ≤ n)
+    (hs_range : ∀ a ∈ s, Set.range a ⊆ Set.Icc 1 n)
+    (hs_length : n ^ 2 < s.length) :
+    ∃ (i j : Fin s.length), i ≠ j ∧ s[i] 0 = s[j] 0 ∧ s[i] 1 = s[j] 1 := by
+  classical
+  let f : Fin s.length → ℕ × ℕ := fun k => (s[k] 0, s[k] 1)
+  let t : Finset (ℕ × ℕ) := Finset.Icc 1 n ×ˢ Finset.Icc 1 n
+  have ht_card : t.card < (Finset.univ : Finset (Fin s.length)).card := by
+    simp only [t, Finset.card_univ, Fintype.card_fin, Finset.card_product,
+      Nat.card_Icc, Nat.add_sub_cancel, ← sq]
+    exact hs_length
+  have hf : ∀ k ∈ (Finset.univ : Finset (Fin s.length)), f k ∈ t := by
+    intro k _
+    have hmem : s[k] ∈ s := List.getElem_mem k.isLt
+    have h0 := hs_range _ hmem ⟨0, rfl⟩
+    have h1 := hs_range _ hmem ⟨1, rfl⟩
+    rw [Set.mem_Icc] at h0 h1
+    simp only [t, f, Finset.mem_product, Finset.mem_Icc]
+    exact ⟨h0, h1⟩
+  obtain ⟨i, _, j, _, hij, hfij⟩ :=
+    Finset.exists_ne_map_eq_of_card_lt_of_maps_to ht_card hf
+  exact ⟨i, j, hij, congrArg Prod.fst hfij, congrArg Prod.snd hfij⟩
+
+/-! Every admissible list has length at most `n ^ 2`. -/
+lemma admissible_length_le_sq {s : List (Fin 3 → ℕ)} {n : ℕ}
+    (hs_range : ∀ a ∈ s, Set.range a ⊆ Set.Icc 1 n)
+    (hs_inc : IsIncreasingTwo s) : s.length ≤ n ^ 2 := by
+  by_cases hn : 2 ≤ n
+  · by_contra hle
+    have hs_length : n ^ 2 < s.length := Nat.lt_of_not_ge hle
+    obtain ⟨i, j, hij, h0, h1⟩ :=
+      exists_pair_of_mem_Icc hn hs_range hs_length
+    rcases lt_or_gt_of_ne hij with hij | hji
+    · exact (not_ltTwo_of_first_two_eq h0 h1)
+        (List.pairwise_iff_get.1 hs_inc i j hij)
+    · exact (not_ltTwo_of_first_two_eq h0.symm h1.symm)
+        (List.pairwise_iff_get.1 hs_inc j i hji)
+  · have hn' : n ≤ 1 := by omega
+    interval_cases n
+    · have hs_empty : s = [] := by
+        apply List.eq_nil_iff_forall_not_mem.mpr
+        intro a ha
+        have hcoord := hs_range a ha ⟨0, rfl⟩
+        rw [Set.mem_Icc] at hcoord
+        omega
+      simp [hs_empty]
+    · have hconst : ∀ a ∈ s, ∀ j, a j = 1 := by
+        intro a ha j
+        have hcoord := hs_range a ha ⟨j, rfl⟩
+        rw [Set.mem_Icc] at hcoord
+        exact hcoord.2.antisymm hcoord.1
+      have hsmall : s.length < 2 := by
+        by_contra hlen
+        have hlen' : 2 ≤ s.length := by omega
+        let i : Fin s.length := ⟨0, by omega⟩
+        let j : Fin s.length := ⟨1, by omega⟩
+        have hij : i < j := by simp [i, j]
+        have hab := List.pairwise_iff_get.1 hs_inc i j hij
+        have ha0 := hconst s[i] (List.get_mem s i) 0
+        have hb0 := hconst s[j] (List.get_mem s j) 0
+        have ha1 := hconst s[i] (List.get_mem s i) 1
+        have hb1 := hconst s[j] (List.get_mem s j) 1
+        exact not_ltTwo_of_first_two_eq (ha0.trans hb0.symm)
+          (ha1.trans hb1.symm) hab
+      norm_num
+      omega
+
+lemma admissible_lengths_bdd (n : ℕ) :
+    BddAbove { List.length s |
+      (s : List (Fin 3 → ℕ))
+      (_ : ∀ a ∈ s, Set.range a ⊆ Set.Icc 1 n)
+      (_ : IsIncreasingTwo s) } := by
+  refine ⟨n ^ 2, ?_⟩
+  intro x hx
+  obtain ⟨s, hs_range, hs_inc, rfl⟩ := hx
+  exact admissible_length_le_sq hs_range hs_inc
+
+/-! The literal source function obeys the elementary quadratic bound. -/
+theorem maximalLength_le (n : ℕ) : maximalLength n ≤ n ^ 2 := by
+  rw [maximalLength]
+  refine csSup_le ?_ ?_
+  · exact ⟨0, ⟨[], by simp, by simp [IsIncreasingTwo], rfl⟩⟩
+  · intro x hx
+    obtain ⟨s, hs_range, hs_inc, rfl⟩ := hx
+    exact admissible_length_le_sq hs_range hs_inc
+
+/-!
+Exact root.  The witness is intentionally signed negatively because the
+frozen declaration has no positivity side condition on `Ω`.
+-/
+theorem theorem_complete : FrozenStatement := by
+  let f : ℕ → ℝ := fun n => (Real.iteratedLog n : ℝ)
+  let Ω : ℕ → ℝ := fun n => -|f n|
+  refine ⟨Ω, ?_, ?_⟩
+  · dsimp [Ω, f]
+    exact Asymptotics.isBigO_neg_right.mpr
+      (Asymptotics.isBigO_abs_right.mpr (Asymptotics.isBigO_refl _ _))
+  · intro n
+    have hbound : (maximalLength n : ℝ) ≤ (n : ℝ) ^ 2 := by
+      exact_mod_cast maximalLength_le n
+    have hden_pos : 0 < Real.exp (-|f n|) := Real.exp_pos _
+    have hden_le : Real.exp (-|f n|) ≤ 1 := by
+      exact Real.exp_le_one_iff.mpr (neg_nonpos.mpr (abs_nonneg _))
+    calc
+      (maximalLength n : ℝ) ≤ (n : ℝ) ^ 2 := hbound
+      _ ≤ (n : ℝ) ^ 2 / Real.exp (-|f n|) := by
+        apply (le_div_iff₀ hden_pos).2
+        nlinarith [sq_nonneg (n : ℝ)]
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003493
