@@ -0,0 +1,50 @@
+import Mathlib
+
+/-!
+# S5-CLM-00003493 — exact statement replay
+
+This module replays the definitions used by the frozen declaration
+`Arxiv.«1609.08688».maximalLength_le_isBigO` at Formal Conjectures revision
+`2270d31e8dd611521f979de6d86da364930b7669`.  The source imports a small
+`FormalConjecturesForMathlib` extension defining the iterated logarithm; the
+definition is reproduced here so the target can be elaborated from the pinned
+Awesome Theorems environment without importing a provider theorem body.
+-/
+
+/- The source-side helper is a total natural-valued iterated logarithm. -/
+noncomputable def Real.iteratedLog (x : ℝ) : ℕ :=
+  sInf { (n : ℕ) | Real.log^[n] x ≤ 1 }
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003493
+
+/-! `lt₂` and `IsIncreasing₂`, with ASCII names for a stable local API. -/
+def ltTwo {α : Type*} [LT α] (a b : Fin 3 → α) : Prop :=
+  ∃ (i j : Fin 3), i ≠ j ∧ a i < b i ∧ a j < b j
+
+def IsIncreasingTwo {α : Type*} [LT α] (s : List (Fin 3 → α)) : Prop :=
+  s.Pairwise ltTwo
+
+/-! The source extremal function `F`. -/
+noncomputable def maximalLength (n : ℕ) : ℕ :=
+  sSup { List.length s |
+    (s : List (Fin 3 → ℕ))
+    (_ : ∀ a ∈ s, Set.range a ⊆ Set.Icc 1 n)
+    (_ : IsIncreasingTwo s) }
+
+/-!
+The exact frozen proposition.  The negative witness used by the local proof
+is permitted by the literal source type: no positivity condition is attached
+to `Ω`.
+-/
+open Filter
+def FrozenStatement : Prop := ∃ Ω : ℕ → ℝ,
+    (fun (n : ℕ) => (Real.iteratedLog n : ℝ)) =O[atTop] Ω ∧
+      ∀ n, maximalLength n ≤ n ^ 2 / Real.exp (Ω n)
+
+abbrev Target : Prop := FrozenStatement
+
+theorem frozen_to_target : FrozenStatement → Target := id
+
+theorem target_to_frozen : Target → FrozenStatement := id
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003493
