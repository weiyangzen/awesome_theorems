@@ -0,0 +1,45 @@
+import Mathlib
+
+/-!
+# S5-CLM-00003491: square lower bound for 2-increasing triples
+
+This module restates the frozen Formal Conjectures definitions and exposes the
+exact proposition whose source declaration is
+`Arxiv.«1609.08688».maximalLength_ge_of_isSquare`.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003491
+
+/-- The source relation: two of the three coordinates strictly increase. -/
+def ltTwo {α : Type*} [LT α] (a b : Fin 3 → α) : Prop :=
+  ∃ (i j : Fin 3), i ≠ j ∧ a i < b i ∧ a j < b j
+
+/-- The source list predicate, with all earlier/later pairs related by `ltTwo`. -/
+def IsIncreasingTwo {α : Type*} [LT α] (s : List (Fin 3 → α)) : Prop :=
+  s.Pairwise ltTwo
+
+/--
+The exact source extremal function: the supremum of lengths of admissible
+2-increasing lists whose coordinates lie in the inclusive interval `[1,n]`.
+-/
+noncomputable def maximalLength (n : ℕ) : ℕ :=
+  sSup { List.length s |
+    (s : List (Fin 3 → ℕ))
+    (_ : ∀ a ∈ s, Set.range a ⊆ Set.Icc 1 n)
+    (_ : IsIncreasingTwo s) }
+
+/-- The exact elaborated target proposition. -/
+def Statement : Prop :=
+  ∀ {n : ℕ}, IsSquare n → n.sqrt ^ 3 ≤ maximalLength n
+
+/-- Definitional source-to-canonical transport. -/
+theorem source_to_canonical :
+    (∀ {n : ℕ}, IsSquare n → n.sqrt ^ 3 ≤ maximalLength n) → Statement :=
+  id
+
+/-- Definitional canonical-to-source transport. -/
+theorem canonical_to_source :
+    Statement → (∀ {n : ℕ}, IsSquare n → n.sqrt ^ 3 ≤ maximalLength n) :=
+  id
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003491
