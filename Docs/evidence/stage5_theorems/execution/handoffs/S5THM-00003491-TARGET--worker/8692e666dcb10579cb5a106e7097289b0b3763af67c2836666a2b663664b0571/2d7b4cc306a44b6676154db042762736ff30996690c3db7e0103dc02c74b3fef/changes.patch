+import AwesomeTheorems.Stage5.Theorems.S5_CLM_00003491.Statement
+
+/-!
+# Kernel proof for S5-CLM-00003491
+
+For `n = m²`, the list below enumerates triples of digits `(i,j,k)` in
+lexicographic order and sends them to
+
+`(i*m+j+1, i*m+k+1, j*m+k+1)`.
+
+At the first digit at which two indices differ, two displayed coordinates
+strictly increase.  All coordinates lie in `[1,m²]`, and the list has `m³`
+entries.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003491
+
+/-- A base-`m` two-digit encoding is strictly monotone in its first digit. -/
+lemma encode_lt {m a b c d : ℕ} (hab : a < b) (hc : c < m) :
+    a * m + c < b * m + d := by
+  have h₁ : a * m + c < a * m + m := Nat.add_lt_add_left hc (a * m)
+  have h₂ : a * m + m = (a + 1) * m := by simp [Nat.add_mul]
+  have h₃ : (a + 1) * m ≤ b * m :=
+    Nat.mul_le_mul_right m (Nat.succ_le_iff.mpr hab)
+  calc
+    a * m + c < a * m + m := h₁
+    _ = (a + 1) * m := h₂
+    _ ≤ b * m := h₃
+    _ ≤ b * m + d := Nat.le_add_right _ _
+
+/-- The triple attached to one three-digit index. -/
+def gridTriple (m i j k : ℕ) : Fin 3 → ℕ :=
+  ![i * m + j + 1, i * m + k + 1, j * m + k + 1]
+
+/-- The complete lexicographically ordered `m × m × m` construction. -/
+def gridSequence (m : ℕ) : List (Fin 3 → ℕ) :=
+  (List.range m).flatMap fun i =>
+    (List.range m).flatMap fun j =>
+      (List.range m).map fun k => gridTriple m i j k
+
+lemma gridTriple_ltTwo_of_k_lt {m i j k k' : ℕ} (hkk' : k < k') :
+    ltTwo (gridTriple m i j k) (gridTriple m i j k') := by
+  refine ⟨1, 2, by decide, ?_, ?_⟩
+  · simpa [gridTriple] using
+      Nat.add_lt_add_right (Nat.add_lt_add_left hkk' (i * m)) 1
+  · simpa [gridTriple] using
+      Nat.add_lt_add_right (Nat.add_lt_add_left hkk' (j * m)) 1
+
+lemma gridTriple_ltTwo_of_j_lt {m i j j' k k' : ℕ}
+    (hjj' : j < j') (hk : k < m) :
+    ltTwo (gridTriple m i j k) (gridTriple m i j' k') := by
+  refine ⟨0, 2, by decide, ?_, ?_⟩
+  · simpa [gridTriple] using Nat.add_lt_add_left hjj' (i * m + 1)
+  · simpa [gridTriple] using Nat.add_lt_add_right (encode_lt hjj' hk (d := k')) 1
+
+lemma gridTriple_ltTwo_of_i_lt {m i i' j j' k k' : ℕ}
+    (hii' : i < i') (hj : j < m) (hk : k < m) :
+    ltTwo (gridTriple m i j k) (gridTriple m i' j' k') := by
+  refine ⟨0, 1, by decide, ?_, ?_⟩
+  · simpa [gridTriple] using Nat.add_lt_add_right (encode_lt hii' hj (d := j')) 1
+  · simpa [gridTriple] using Nat.add_lt_add_right (encode_lt hii' hk (d := k')) 1
+
+/-- Every two entries in construction order are 2-increasing. -/
+lemma gridSequence_isIncreasing (m : ℕ) : IsIncreasingTwo (gridSequence m) := by
+  classical
+  unfold IsIncreasingTwo gridSequence
+  rw [List.pairwise_flatMap]
+  constructor
+  · intro i hi
+    rw [List.pairwise_flatMap]
+    constructor
+    · intro j hj
+      rw [List.pairwise_map]
+      exact List.pairwise_lt_range.imp fun h => gridTriple_ltTwo_of_k_lt h
+    · refine List.pairwise_lt_range.imp fun hjj' => ?_
+      intro x hx y hy
+      simp only [List.mem_map] at hx hy
+      obtain ⟨k, hk, rfl⟩ := hx
+      obtain ⟨k', hk', rfl⟩ := hy
+      exact gridTriple_ltTwo_of_j_lt hjj' (List.mem_range.mp hk)
+  · refine List.pairwise_lt_range.imp fun hii' => ?_
+    intro x hx y hy
+    simp only [List.mem_flatMap, List.mem_map] at hx hy
+    obtain ⟨j, hj, k, hk, rfl⟩ := hx
+    obtain ⟨j', hj', k', hk', rfl⟩ := hy
+    exact gridTriple_ltTwo_of_i_lt hii' (List.mem_range.mp hj) (List.mem_range.mp hk)
+
+/-- Every construction coordinate lies in `[1,m²]`. -/
+lemma gridSequence_range (m : ℕ) :
+    ∀ a ∈ gridSequence m, Set.range a ⊆ Set.Icc 1 (m * m) := by
+  classical
+  intro a ha
+  simp only [gridSequence, List.mem_flatMap, List.mem_map] at ha
+  obtain ⟨i, hi, j, hj, k, hk, rfl⟩ := ha
+  have hi' := List.mem_range.mp hi
+  have hj' := List.mem_range.mp hj
+  have hk' := List.mem_range.mp hk
+  intro x hx
+  obtain ⟨r, rfl⟩ := hx
+  fin_cases r
+  · simp [gridTriple, Set.mem_Icc]
+    exact encode_lt hi' hj' (d := 0)
+  · simp [gridTriple, Set.mem_Icc]
+    exact encode_lt hi' hk' (d := 0)
+  · simp [gridTriple, Set.mem_Icc]
+    exact encode_lt hj' hk' (d := 0)
+
+/-- The construction contains exactly `m³` entries. -/
+lemma gridSequence_length (m : ℕ) : (gridSequence m).length = m ^ 3 := by
+  simp [gridSequence, pow_succ, Nat.mul_assoc]
+
+/-- Two entries sharing their first two coordinates cannot occur at distinct positions. -/
+lemma not_ltTwo_of_first_two_eq {a b : Fin 3 → ℕ}
+    (h0 : a 0 = b 0) (h1 : a 1 = b 1) : ¬ltTwo a b := by
+  rintro ⟨i, j, hij, hi, hj⟩
+  fin_cases i <;> fin_cases j <;> simp_all
+
+/-- Pigeonhole bound used only to certify that the defining supremum is bounded. -/
+lemma exists_pair_of_length_gt_sq {s : List (Fin 3 → ℕ)} {n : ℕ} (_hn : 2 ≤ n)
+    (hsRange : ∀ a ∈ s, Set.range a ⊆ Set.Icc 1 n) (hsLength : n ^ 2 < s.length) :
+    ∃ (i j : Fin s.length), i ≠ j ∧ s[i] 0 = s[j] 0 ∧ s[i] 1 = s[j] 1 := by
+  classical
+  let f : Fin s.length → ℕ × ℕ := fun k => (s[k] 0, s[k] 1)
+  let t : Finset (ℕ × ℕ) := Finset.Icc 1 n ×ˢ Finset.Icc 1 n
+  have htCard : t.card < (Finset.univ : Finset (Fin s.length)).card := by
+    simp only [t, Finset.card_univ, Fintype.card_fin, Finset.card_product,
+      Nat.card_Icc, Nat.add_sub_cancel, ← sq]
+    exact hsLength
+  have hf : ∀ k ∈ (Finset.univ : Finset (Fin s.length)), f k ∈ t := by
+    intro k _
+    have hmem : s[k] ∈ s := List.getElem_mem k.isLt
+    have h0 := hsRange _ hmem ⟨0, rfl⟩
+    have h1 := hsRange _ hmem ⟨1, rfl⟩
+    rw [Set.mem_Icc] at h0 h1
+    simp only [t, f, Finset.mem_product, Finset.mem_Icc]
+    exact ⟨h0, h1⟩
+  obtain ⟨i, _, j, _, hij, hfij⟩ :=
+    Finset.exists_ne_map_eq_of_card_lt_of_maps_to htCard hf
+  exact ⟨i, j, hij, congrArg Prod.fst hfij, congrArg Prod.snd hfij⟩
+
+/-- All admissible lengths are bounded by `n²`. -/
+lemma admissible_length_le_sq {s : List (Fin 3 → ℕ)} {n : ℕ}
+    (hsRange : ∀ a ∈ s, Set.range a ⊆ Set.Icc 1 n)
+    (hsInc : IsIncreasingTwo s) : s.length ≤ n ^ 2 := by
+  by_cases hn : 2 ≤ n
+  · by_contra hle
+    have hsLength : n ^ 2 < s.length := Nat.lt_of_not_ge hle
+    obtain ⟨i, j, hij, h0, h1⟩ := exists_pair_of_length_gt_sq hn hsRange hsLength
+    rcases lt_or_gt_of_ne hij with hij | hji
+    · exact (not_ltTwo_of_first_two_eq h0 h1)
+        (List.pairwise_iff_get.1 hsInc i j hij)
+    · exact (not_ltTwo_of_first_two_eq h0.symm h1.symm)
+        (List.pairwise_iff_get.1 hsInc j i hji)
+  · have hn' : n ≤ 1 := by omega
+    interval_cases n
+    · have hsEmpty : s = [] := by
+        apply List.eq_nil_iff_forall_not_mem.mpr
+        intro a ha
+        have hcoord := hsRange a ha ⟨0, rfl⟩
+        rw [Set.mem_Icc] at hcoord
+        omega
+      simp [hsEmpty]
+    · have hconst : ∀ a ∈ s, ∀ j, a j = 1 := by
+        intro a ha j
+        have hcoord := hsRange a ha ⟨j, rfl⟩
+        rw [Set.mem_Icc] at hcoord
+        exact hcoord.2.antisymm hcoord.1
+      have hsmall : s.length < 2 := by
+        by_contra hlen
+        have hlen' : 2 ≤ s.length := by omega
+        let i : Fin s.length := ⟨0, by omega⟩
+        let j : Fin s.length := ⟨1, by omega⟩
+        have hij : i < j := by simp [i, j]
+        have hab := List.pairwise_iff_get.1 hsInc i j hij
+        have ha0 := hconst s[i] (List.get_mem s i) 0
+        have hb0 := hconst s[j] (List.get_mem s j) 0
+        have ha1 := hconst s[i] (List.get_mem s i) 1
+        have hb1 := hconst s[j] (List.get_mem s j) 1
+        exact not_ltTwo_of_first_two_eq (ha0.trans hb0.symm) (ha1.trans hb1.symm) hab
+      norm_num
+      omega
+
+/-- The explicit construction gives the desired lower bound at every square. -/
+lemma grid_lower_bound (m : ℕ) : m ^ 3 ≤ maximalLength (m * m) := by
+  let lengths : Set ℕ := { List.length s |
+    (s : List (Fin 3 → ℕ))
+    (_ : ∀ a ∈ s, Set.range a ⊆ Set.Icc 1 (m * m))
+    (_ : IsIncreasingTwo s) }
+  have hbdd : BddAbove lengths := by
+    refine ⟨(m * m) ^ 2, ?_⟩
+    intro x hx
+    obtain ⟨s, hsRange, hsInc, rfl⟩ := hx
+    exact admissible_length_le_sq hsRange hsInc
+  have hmem : (gridSequence m).length ∈ lengths := by
+    exact ⟨gridSequence m, gridSequence_range m, gridSequence_isIncreasing m, rfl⟩
+  rw [maximalLength]
+  change m ^ 3 ≤ sSup lengths
+  rw [← gridSequence_length m]
+  exact le_csSup hbdd hmem
+
+/-- Exact source-named theorem, now closed without `sorryAx`. -/
+theorem maximalLength_ge_of_isSquare {n : ℕ} (h : IsSquare n) :
+    n.sqrt ^ 3 ≤ maximalLength n := by
+  rcases h with ⟨m, rfl⟩
+  simpa [Nat.sqrt_eq] using grid_lower_bound m
+
+/-- Closure of the canonical proposition. -/
+theorem theorem_complete : Statement :=
+  source_to_canonical maximalLength_ge_of_isSquare
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003491
