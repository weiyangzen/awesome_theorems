+import AwesomeTheorems.Stage5.Theorems.S5_CLM_00003491.Proof
+import Lean.Util.CollectAxioms
+
+/-!
+# Trust and exact-type audit for S5-CLM-00003491
+
+This module is deliberately executable evidence: the two probes below fail to
+elaborate if either the source-shaped conclusion or the canonical proposition
+drifts.  The `#print axioms` commands expose the kernel dependency boundary in
+the cold-build transcript.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003491
+
+open Lean Elab Command
+
+/--
+Replay one target-local declaration from the checked kernel environment.  The
+command fails if the declaration is missing, bodyless, or reaches any axiom
+outside the exact foundation set observed for this target.  Its deterministic
+type/body expression hashes feed the content-addressed declaration census.
+-/
+elab "#audit_decl " n:ident : command => do
+  let name := `AwesomeTheorems.Stage5.Theorems.S5_CLM_00003491 ++ n.getId
+  let env ← getEnv
+  let some info := env.find? name
+    | throwError "missing checked declaration {name}"
+  let some value := info.value?
+    | throwError "bodyless target-local declaration {name}"
+  let axioms ← Lean.collectAxioms name
+  let allowed : Array Name := #[``Classical.choice, ``Quot.sound, ``propext]
+  let unexpected := axioms.filter fun axiomName => !allowed.contains axiomName
+  unless unexpected.isEmpty do
+    throwError "unexpected axiom closure for {name}: {unexpected}"
+  let axiomNames := String.intercalate "," <|
+    (axioms.toList.map (·.toString)).mergeSort (· < ·)
+  logInfo m!"CENSUS\t{name}\t{info.type.hash}\t{value.hash}\t[{axiomNames}]"
+
+#audit_decl ltTwo
+#audit_decl IsIncreasingTwo
+#audit_decl maximalLength
+#audit_decl Statement
+#audit_decl source_to_canonical
+#audit_decl canonical_to_source
+#audit_decl encode_lt
+#audit_decl gridTriple
+#audit_decl gridSequence
+#audit_decl gridTriple_ltTwo_of_k_lt
+#audit_decl gridTriple_ltTwo_of_j_lt
+#audit_decl gridTriple_ltTwo_of_i_lt
+#audit_decl gridSequence_isIncreasing
+#audit_decl gridSequence_range
+#audit_decl gridSequence_length
+#audit_decl not_ltTwo_of_first_two_eq
+#audit_decl exists_pair_of_length_gt_sq
+#audit_decl admissible_length_le_sq
+#audit_decl grid_lower_bound
+#audit_decl maximalLength_ge_of_isSquare
+#audit_decl theorem_complete
+
+/-- Exact source declaration-type probe. -/
+theorem source_type_probe {n : ℕ} (h : IsSquare n) :
+    n.sqrt ^ 3 ≤ maximalLength n :=
+  maximalLength_ge_of_isSquare h
+
+/-- Exact canonical-root type probe. -/
+theorem canonical_type_probe : Statement :=
+  theorem_complete
+
+#print axioms maximalLength_ge_of_isSquare
+#print axioms theorem_complete
+#check source_to_canonical
+#check canonical_to_source
