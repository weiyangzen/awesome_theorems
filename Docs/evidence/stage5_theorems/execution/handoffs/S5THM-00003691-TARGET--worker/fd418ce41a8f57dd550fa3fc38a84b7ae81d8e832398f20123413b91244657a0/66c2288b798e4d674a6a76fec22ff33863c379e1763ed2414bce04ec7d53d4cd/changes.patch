+            (if Odd k then 1 else 2))) :
+    ∀ (k n : ℕ), 5 ≤ k → k ≤ n →
+      let ℓ := (k - 1) / 2
+      let ε := if Odd k then 1 else 2
+      antiRamsey (pathGraph k) n =
