+import Mathlib
+
+/-!
+# S5-CLM-00003492 — exact statement replay
+
+This module reconstructs the definitions surrounding the frozen declaration
+`Arxiv.«1609.08688».maximalLength_le` at Formal Conjectures revision
+`2270d31e8dd611521f979de6d86da364930b7669`.  In that source module the local
+notation `F` abbreviates `maximalLength`; `FrozenStatement` expands only that
+notation and preserves the explicit natural-number binder and conclusion.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003492
+
+/-- Two triples are related when they strictly increase in two distinct
+coordinates.  This replays the source definition `lt₂`. -/
+def ltTwo {α : Type*} [LT α] (a b : Fin 3 → α) : Prop :=
+  ∃ (i j : Fin 3), i ≠ j ∧ a i < b i ∧ a j < b j
+
+/-- Pairwise two-coordinate increase for a list of triples. -/
+def IsIncreasingTwo {α : Type*} [LT α] (s : List (Fin 3 → α)) : Prop :=
+  s.Pairwise ltTwo
+
+/-- The source extremal function: the natural supremum of admissible list
+lengths. -/
+noncomputable def maximalLength (n : ℕ) : ℕ :=
+  sSup { List.length s |
+    (s : List (Fin 3 → ℕ))
+    (_ : ∀ a ∈ s, Set.range a ⊆ Set.Icc 1 n)
+    (_ : IsIncreasingTwo s) }
+
+/-- The proposition obtained from the frozen declaration
+`theorem maximalLength_le (n : ℕ) : F n ≤ n ^ 2` by abstracting its explicit
+binder and expanding only the local notation `F`. -/
+def FrozenStatement : Prop :=
+  ∀ (n : ℕ), maximalLength n ≤ n ^ 2
+
+/-- Canonical target proposition.  Transparency makes it definitionally
+identical to `FrozenStatement`. -/
+abbrev Target : Prop := FrozenStatement
+
+/-- Forward half of the executable statement crosswalk. -/
+theorem frozen_to_target : FrozenStatement → Target := id
+
+/-- Reverse half of the executable statement crosswalk. -/
+theorem target_to_frozen : Target → FrozenStatement := id
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003492
