+theorem audit
+    (certificate : ∀ n : Fin (2 ^ 50), Odd n.1 → 1 < n.1 →
+      ∃ k : Fin (2 ^ 50), ∃ l : Fin 50,
+        Squarefree k.1 ∧ n.1 = k.1 + 2 ^ l.1)
+    (n : ℕ) (hn : Odd n) (h : n < 2 ^ 50) (hn' : 1 < n) :
+    ∃ k l : ℕ, Squarefree k ∧ n = k + 2 ^ l := by
+  rcases certificate ⟨n, h⟩ hn hn' with ⟨k, l, hk, rfl⟩
+  exact ⟨k.1, l.1, hk, rfl⟩
