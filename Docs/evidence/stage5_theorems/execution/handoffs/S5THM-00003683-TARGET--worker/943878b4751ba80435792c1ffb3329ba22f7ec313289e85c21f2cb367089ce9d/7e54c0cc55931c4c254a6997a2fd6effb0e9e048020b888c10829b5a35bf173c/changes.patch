+    ∀ n : ℕ, Odd n → n < 2 ^ 50 → 1 < n →
+      ∃ k l : ℕ, Squarefree k ∧ n = k + 2 ^ l := p
+
+theorem target_to_source
+    (p : ∀ n : ℕ, Odd n → n < 2 ^ 50 → 1 < n →
