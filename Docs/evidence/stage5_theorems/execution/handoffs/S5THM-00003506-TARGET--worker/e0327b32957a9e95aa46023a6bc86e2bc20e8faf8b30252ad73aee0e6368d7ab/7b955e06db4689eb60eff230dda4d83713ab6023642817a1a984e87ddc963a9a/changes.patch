@@ -0,0 +1,60 @@
+import AwesomeTheorems.Stage5.Theorems.S5_CLM_00003506.Statement
+
+/-!
+# Trust-zero proof frontier
+
+The provider declaration is statement provenance only.  This module records
+the exact transports and the formal shape of a refutation, without importing
+an untrusted body or replacing the analytic counterexample by an oracle.
+-/
+
+noncomputable section
+
+open scoped Topology
+open Filter MeasureTheory UnitAddCircle
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003506
+
+theorem transport_forward (h : FrozenStatement) : Target :=
+  frozen_to_target h
+
+theorem transport_reverse (h : Target) : FrozenStatement :=
+  target_to_frozen h
+
+abbrev ConvergenceClaim : Prop :=
+  ∀ p q : ℕ, 2 <= p → 2 <= q → MultiplicativelyIndependent p q →
+    ∀ μ : MeasureTheory.ProbabilityMeasure 𝕋,
+      MeasureTheory.IsAtomLess μ.1 → MeasurePreserving (Tn p) μ μ →
+      Tendsto (fun n : ℕ => μ.map (Tn_continuous (q ^ n)).aemeasurable) atTop
+        (𝓝 UnitAddCircle.ProbabilityMeasure)
+
+theorem target_iff_convergence :
+    Target ↔ (False ↔ ConvergenceClaim) := by
+  rfl
+
+/-! A concrete witness of failed convergence is exactly what the paper's
+    disproof must provide at the frozen formal boundary. -/
+def RefutationWitness : Prop :=
+  ∃ (p q : ℕ) (μ : MeasureTheory.ProbabilityMeasure 𝕋),
+    2 <= p ∧ 2 <= q ∧ MultiplicativelyIndependent p q ∧
+    MeasureTheory.IsAtomLess μ.1 ∧ MeasurePreserving (Tn p) μ μ ∧
+    ¬ Tendsto (fun n : ℕ => μ.map (Tn_continuous (q ^ n)).aemeasurable) atTop
+      (𝓝 UnitAddCircle.ProbabilityMeasure)
+
+theorem source_of_refutation (h : RefutationWitness) : SourceStatement := by
+  rcases h with ⟨p, q, μ, hp, hq, hpq, h_atomless, h_preserving, h_not⟩
+  constructor
+  · intro hfalse
+    exact False.elim hfalse
+  · intro hall
+    exact h_not (hall p q hp hq hpq μ h_atomless h_preserving)
+
+theorem target_of_refutation (h : RefutationWitness) : Target :=
+  frozen_to_target (source_of_refutation h)
+
+/-! The following implication isolates the missing analytic root while
+    remaining a fully elaborated, kernel-checked theorem. -/
+theorem refutation_root_shape :
+    RefutationWitness → Target := target_of_refutation
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003506
