+import Mathlib
+
+/-!
+# S5-CLM-00003506 — Furstenberg times-p, times-q convergence
+
+This file replays the frozen source declaration without importing the
+`sorryAx`-bearing provider theorem.  The source-side definitions are kept
+local so that the canonical proposition has the same elaborated type while
+remaining a trust-zero, self-contained statement artifact.
+-/
+
+noncomputable section
+
+open scoped Topology
+open Filter MeasureTheory UnitAddCircle
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003506
+
+notation "𝕋" => UnitAddCircle
+
+def MultiplicativelyIndependent (p q : ℕ) : Prop :=
+  Irrational (Real.log p / Real.log q)
+
+def Tn (n : ℕ) (x : 𝕋) := n • x
+
+lemma Tn_continuous (n : ℕ) : Continuous (Tn n) := continuous_nsmul n
+
+def MeasureTheory.IsAtom {α : Type*} {m0 : MeasurableSpace α}
+    (μ : Measure α) (A : Set α) : Prop :=
+  0 < μ A ∧ ∀ B ⊆ A, MeasurableSet B → μ B = 0 ∨ μ B = μ A
+
+class MeasureTheory.IsAtomLess {α : Type*} {m0 : MeasurableSpace α}
+    (μ : Measure α) : Prop where
+  NoAtoms : ∀ A, MeasurableSet A → ¬ MeasureTheory.IsAtom μ A
+
+def UnitAddCircle.ProbabilityMeasure : MeasureTheory.ProbabilityMeasure 𝕋 :=
+  ⟨volume, IsProbabilityMeasure.mk UnitAddCircle.measure_univ⟩
+
+/-- The exact source proposition, with `answer(False)` elaborated as `False`. -/
+abbrev SourceStatement : Prop :=
+  False ↔
+    ∀ p q : ℕ, 2 <= p → 2 <= q → MultiplicativelyIndependent p q →
+      ∀ μ : MeasureTheory.ProbabilityMeasure 𝕋,
+        MeasureTheory.IsAtomLess μ.1 → MeasurePreserving (Tn p) μ μ →
+        Tendsto (fun n : ℕ => μ.map (Tn_continuous (q ^ n)).aemeasurable) atTop
+          (𝓝 UnitAddCircle.ProbabilityMeasure)
+
+abbrev FrozenStatement : Prop := SourceStatement
+
+abbrev Target : Prop := FrozenStatement
+
+theorem frozen_to_target : FrozenStatement → Target := fun h => h
+
+theorem target_to_frozen : Target → FrozenStatement := fun h => h
+
+theorem source_to_target : SourceStatement → Target := fun h => frozen_to_target h
+
+theorem target_to_source : Target → SourceStatement := fun h => target_to_frozen h
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003506
