@@ -0,0 +1,47 @@
+import Mathlib
+
+/-!
+# S5-CLM-00003502 — one-variable Zariski cancellation
+
+This module is a statement replay for the pinned `formal-conjectures`
+record.  The provider body is not imported: it is statement provenance only,
+and the recorded source declaration has no proof authority for this handoff.
+The universe parameter on `FrozenStatement` is explicit so that the
+universally quantified algebra `B` has exactly the independent universe that
+Lean assigns to the source definition.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003502
+
+open Polynomial
+
+/-! The source-local definition, replayed without changing its binder order. -/
+def IsCancellative (k A : Type*) [Field k]
+    [CommRing A] [Algebra k A] [Algebra.FiniteType k A] : Prop := ∀ {B : Type*}
+    [CommRing B] [Algebra k B] [Algebra.FiniteType k B], Nonempty (A[X] ≃ₐ[k] B[X]) →
+    Nonempty (A ≃ₐ[k] B)
+
+universe u v
+
+/-- The exact frozen proposition, with the source's independent `B` universe. -/
+abbrev FrozenStatement (k : Type u) [Field k] : Prop :=
+  IsCancellative.{u, u, v} k k[X]
+
+/-- Target-facing name; definitionally equal to the frozen proposition. -/
+abbrev Target (k : Type u) [Field k] : Prop := FrozenStatement.{u, v} k
+
+/-- Forward transport is definitionally identity. -/
+theorem frozen_to_target {k : Type u} [Field k] :
+    FrozenStatement.{u, v} k → Target.{u, v} k := fun h => h
+
+/-- Reverse transport is definitionally identity. -/
+theorem target_to_frozen {k : Type u} [Field k] :
+    Target.{u, v} k → FrozenStatement.{u, v} k := fun h => h
+
+example {k : Type u} [Field k] :
+    FrozenStatement.{u, v} k → Target.{u, v} k := frozen_to_target
+
+example {k : Type u} [Field k] :
+    Target.{u, v} k → FrozenStatement.{u, v} k := target_to_frozen
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003502
