+import AwesomeTheorems.Stage5.Theorems.S5_CLM_00003495.Statement
+
+/-!
+# Quantifier audit for S5-CLM-00003495
+
+The frozen proposition is retained verbatim in `Statement.lean`.  The source
+paper and declaration docstring describe an unbounded collection of witnesses,
+whereas the formal conclusion uses `Filter.Eventually` at `Filter.atTop`.
+This module checks the valid implication from the frozen conclusion to the
+documented one and gives a kernel-checked separation of the two quantifiers.
+
+There is deliberately no exact-root declaration here: constructing one from
+the published product argument would strengthen an unbounded-witness result to
+an eventual-all result.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003495
+
+/-- The literal mathematical meaning of “there are arbitrarily large `m`”. -/
+def ArbitrarilyLargeConclusion (e : ℝ) : Prop :=
+  ∀ N : ℕ, ∃ m : ℕ, N ≤ m ∧ (m : ℝ) ^ e ≤ maximalLength m
+
+/-- Every eventually true lower bound supplies arbitrarily large witnesses. -/
+theorem target_implies_arbitrarilyLarge {n : ℕ} {e : ℝ} (hn : 1 < n)
+    (h : maximalLength n = (n : ℝ) ^ e) :
+    Target hn h → ArbitrarilyLargeConclusion e := by
+  intro hEventually N
+  obtain ⟨M, hM⟩ := Filter.eventually_atTop.1 hEventually
+  refine ⟨max N M, le_max_left N M, ?_⟩
+  exact hM (max N M) (le_max_right N M)
+
+/-- A generic unbounded-witness predicate on naturals. -/
+def EvenWitness (m : ℕ) : Prop := ∃ k : ℕ, m = 2 * k
+
+/-- `EvenWitness` holds at arbitrarily large indices. -/
+theorem evenWitness_arbitrarilyLarge :
+    ∀ N : ℕ, ∃ m : ℕ, N ≤ m ∧ EvenWitness m := by
+  intro N
+  refine ⟨2 * N, by omega, N, rfl⟩
+
+/-- `EvenWitness` is not eventually true at `Filter.atTop`. -/
+theorem evenWitness_not_eventually :
+    ¬(∀ᶠ m : ℕ in Filter.atTop, EvenWitness m) := by
+  intro hEventually
+  obtain ⟨M, hM⟩ := Filter.eventually_atTop.1 hEventually
+  obtain ⟨k, hk⟩ := hM (2 * M + 1) (by omega)
+  omega
+
+/-- The two quantifiers used by the frozen type and its prose are not
+interchangeable as a matter of logic. -/
+theorem arbitrarilyLarge_does_not_imply_eventually :
+    ∃ P : ℕ → Prop,
+      (∀ N : ℕ, ∃ m : ℕ, N ≤ m ∧ P m) ∧
+      ¬(∀ᶠ m : ℕ in Filter.atTop, P m) := by
+  exact ⟨EvenWitness, evenWitness_arbitrarilyLarge,
+    evenWitness_not_eventually⟩
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003495
