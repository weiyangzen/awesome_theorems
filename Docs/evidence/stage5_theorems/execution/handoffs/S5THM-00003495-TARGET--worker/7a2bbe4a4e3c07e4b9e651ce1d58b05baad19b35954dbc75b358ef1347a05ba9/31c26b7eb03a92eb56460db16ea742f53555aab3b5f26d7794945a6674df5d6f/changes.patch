+import Mathlib
+
+/-!
+The frozen statement for `Arxiv.«1609.08688».maximalLength_pow`.
+
+The source declaration uses the local notation `F` for the extremal length of
+2-increasing triples.  The definitions below are reproduced verbatim at the
+kernel level; `SourceStatement` and `Target` differ only by an abbreviation so
+that both directions of the crosswalk are definitional transports.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003495
+
+def lt₂ {α : Type*} [LT α] (a b : Fin 3 → α) : Prop :=
+  ∃ (i j : Fin 3), i ≠ j ∧ a i < b i ∧ a j < b j
+
+def IsIncreasing₂ {α : Type*} [LT α] (s : List (Fin 3 → α)) : Prop :=
+  s.Pairwise lt₂
+
+noncomputable def maximalLength (n : ℕ) : ℕ :=
+  sSup { List.length s |
+    (s : List (Fin 3 → ℕ))
+    (_ : ∀ a ∈ s, Set.range a ⊆ Set.Icc 1 n)
+    (_ : IsIncreasing₂ s) }
+
+local notation "F" => maximalLength
+
+/-- Exact source proposition, with the same elaborated type as the frozen row. -/
+abbrev SourceStatement {n : ℕ} {e : ℝ} (hn : 1 < n)
+    (h : F n = (n : ℝ) ^ e) : Prop :=
+  ∀ᶠ m : ℕ in Filter.atTop, (m : ℝ) ^ e ≤ F m
+
+/-- Canonical target name for the exact source proposition. -/
+abbrev Target {n : ℕ} {e : ℝ} (hn : 1 < n)
+    (h : F n = (n : ℝ) ^ e) : Prop :=
+  SourceStatement hn h
+
+theorem source_to_target {n : ℕ} {e : ℝ} (hn : 1 < n)
+    (h : F n = (n : ℝ) ^ e) : SourceStatement hn h → Target hn h := id
+
+theorem target_to_source {n : ℕ} {e : ℝ} (hn : 1 < n)
+    (h : F n = (n : ℝ) ^ e) : Target hn h → SourceStatement hn h := id
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003495
