@@ -0,0 +1,79 @@
+import AwesomeTheorems.Stage5.Theorems.S5_CLM_00003495.Proof
+import Lean.Util.CollectAxioms
+
+/-!
+# Exact-type and quantifier audit for S5-CLM-00003495
+
+The examples below fail if the frozen proposition, either identity transport,
+or the one-way quantifier comparison drifts.  The printed axiom census binds
+the locally proved audit facts to their kernel dependency boundary.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003495
+
+open Lean Elab Command
+
+/--
+Replay one target-local declaration from the checked kernel environment.  The
+command fails if the declaration is missing, bodyless, or reaches an axiom
+outside the exact foundation set observed for this target.  Its deterministic
+type/body expression hashes feed the content-addressed declaration census.
+-/
+elab "#audit_decl " n:ident : command => do
+  let name := `AwesomeTheorems.Stage5.Theorems.S5_CLM_00003495 ++ n.getId
+  let env ← getEnv
+  let some info := env.find? name
+    | throwError "missing checked declaration {name}"
+  let some value := info.value?
+    | throwError "bodyless target-local declaration {name}"
+  let axioms ← Lean.collectAxioms name
+  let allowed : Array Name := #[``Classical.choice, ``Quot.sound, ``propext]
+  let unexpected := axioms.filter fun axiomName => !allowed.contains axiomName
+  unless unexpected.isEmpty do
+    throwError "unexpected axiom closure for {name}: {unexpected}"
+  let axiomNames := String.intercalate "," <|
+    (axioms.toList.map (·.toString)).mergeSort (· < ·)
+  logInfo m!"CENSUS\t{name}\t{info.type.hash}\t{value.hash}\t[{axiomNames}]"
+
+#audit_decl lt₂
+#audit_decl IsIncreasing₂
+#audit_decl maximalLength
+#audit_decl SourceStatement
+#audit_decl Target
+#audit_decl source_to_target
+#audit_decl target_to_source
+#audit_decl ArbitrarilyLargeConclusion
+#audit_decl target_implies_arbitrarilyLarge
+#audit_decl EvenWitness
+#audit_decl evenWitness_arbitrarilyLarge
+#audit_decl evenWitness_not_eventually
+#audit_decl arbitrarilyLarge_does_not_imply_eventually
+
+/-- Exact source-shaped type probe. -/
+example {n : ℕ} {e : ℝ} (hn : 1 < n)
+    (h : maximalLength n = (n : ℝ) ^ e) :
+    SourceStatement hn h → Target hn h :=
+  source_to_target hn h
+
+/-- Reverse exact-type probe. -/
+example {n : ℕ} {e : ℝ} (hn : 1 < n)
+    (h : maximalLength n = (n : ℝ) ^ e) :
+    Target hn h → SourceStatement hn h :=
+  target_to_source hn h
+
+/-- The only valid generic direction between the two audited conclusions. -/
+example {n : ℕ} {e : ℝ} (hn : 1 < n)
+    (h : maximalLength n = (n : ℝ) ^ e) :
+    Target hn h → ArbitrarilyLargeConclusion e :=
+  target_implies_arbitrarilyLarge hn h
+
+#print axioms source_to_target
+#print axioms target_to_source
+#print axioms target_implies_arbitrarilyLarge
+#print axioms arbitrarilyLarge_does_not_imply_eventually
+
+#check SourceStatement
+#check Target
+#check ArbitrarilyLargeConclusion
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003495
