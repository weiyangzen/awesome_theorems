+import Mathlib
+
+/-!
+# S5-CLM-00003504 — positive-characteristic Zariski cancellation counterexample
+
+This module replays the exact proposition frozen from the pinned
+`formal-conjectures` record.  The provider declaration is marked `sorryAx` and
+is therefore statement provenance only; no provider body is imported here.
+The source definition and all typeclass/universe binders are reproduced in an
+independent target-local namespace.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003504
+
+open Polynomial
+
+/-! The source-local cancellation predicate, with its independent algebra
+universe for `B` preserved. -/
+def IsCancellative (k A : Type*) [Field k]
+    [CommRing A] [Algebra k A] [Algebra.FiniteType k A] : Prop := ∀ {B : Type*}
+    [CommRing B] [Algebra k B] [Algebra.FiniteType k B], Nonempty (A[X] ≃ₐ[k] B[X]) →
+    Nonempty (A ≃ₐ[k] B)
+
+universe u v
+
+/-! The exact frozen negative proposition.  `u` is the universe of the
+indexing type `ι`; `v` remains the independent universe quantified by
+`IsCancellative`. -/
+abbrev FrozenStatement (p : ℕ) [Fact p.Prime] {ι : Type u}
+    [Fintype ι] (hι : Fintype.card ι = 3) : Prop :=
+  ¬ IsCancellative.{0, u, v} (ZMod p) (MvPolynomial ι (ZMod p))
+
+/-! Target-facing name; definitionally equal to the frozen proposition. -/
+abbrev Target (p : ℕ) [Fact p.Prime] {ι : Type u}
+    [Fintype ι] (hι : Fintype.card ι = 3) : Prop :=
+  FrozenStatement.{u, v} p hι
+
+/-! Definitional identity transports for the statement crosswalk. -/
+theorem frozen_to_target (p : ℕ) [Fact p.Prime] {ι : Type u}
+    [Fintype ι] (hι : Fintype.card ι = 3) :
+    FrozenStatement.{u, v} p hι → Target.{u, v} p hι := fun h => h
+
+theorem target_to_frozen (p : ℕ) [Fact p.Prime] {ι : Type u}
+    [Fintype ι] (hι : Fintype.card ι = 3) :
+    Target.{u, v} p hι → FrozenStatement.{u, v} p hι := fun h => h
+
+example (p : ℕ) [Fact p.Prime] {ι : Type u} [Fintype ι]
+    (hι : Fintype.card ι = 3) :
+    FrozenStatement.{u, v} p hι → Target.{u, v} p hι :=
+  frozen_to_target p hι
+
+example (p : ℕ) [Fact p.Prime] {ι : Type u} [Fintype ι]
+    (hι : Fintype.card ι = 3) :
+    Target.{u, v} p hι → FrozenStatement.{u, v} p hι :=
+  target_to_frozen p hι
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003504
