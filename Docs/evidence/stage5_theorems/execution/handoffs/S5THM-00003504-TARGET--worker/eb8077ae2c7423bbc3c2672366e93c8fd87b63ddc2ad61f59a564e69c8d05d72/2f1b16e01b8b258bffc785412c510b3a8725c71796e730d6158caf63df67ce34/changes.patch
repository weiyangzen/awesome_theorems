+import AwesomeTheorems.Stage5.Theorems.S5_CLM_00003504.Statement
+
+/-!
+# Trust-zero diagnostic proof units
+
+The provider's negative cancellation theorem is `sorryAx`-bearing and is not
+used as a proof oracle.  This file records the kernel-checked transports, the
+canonical polynomial-extension equivalence, and the generic counterexample
+criterion that exposes exactly what a future mathematical root must provide.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003504
+
+open Polynomial
+
+universe u v uk ua ub
+
+theorem transport_forward (p : ℕ) [Fact p.Prime] {ι : Type u}
+    [Fintype ι] (hι : Fintype.card ι = 3)
+    (h : FrozenStatement.{u, v} p hι) : Target.{u, v} p hι :=
+  frozen_to_target p hι h
+
+theorem transport_reverse (p : ℕ) [Fact p.Prime] {ι : Type u}
+    [Fintype ι] (hι : Fintype.card ι = 3)
+    (h : Target.{u, v} p hι) : FrozenStatement.{u, v} p hι :=
+  target_to_frozen p hι h
+
+/-! The identity equivalence records the polynomial-extension input for the
+canonical algebra `A = MvPolynomial ι (ZMod p)`. -/
+theorem polynomial_self_equivalence (p : ℕ) [Fact p.Prime]
+    {ι : Type u} [Fintype ι] (hι : Fintype.card ι = 3) :
+    Nonempty
+      ((MvPolynomial ι (ZMod p))[X] ≃ₐ[ZMod p]
+        (MvPolynomial ι (ZMod p))[X]) :=
+  ⟨(AlgEquiv.refl :
+    (MvPolynomial ι (ZMod p))[X] ≃ₐ[ZMod p]
+      (MvPolynomial ι (ZMod p))[X])⟩
+
+/-! If a polynomial-extension equivalence has no descended algebra
+equivalence, it is a direct witness that the cancellation predicate is false.
+This is the generic final step; the target-specific counterexample producing
+the two hypotheses remains the open mathematical cut. -/
+theorem not_cancellative_of_counterexample
+    {k : Type uk} {A : Type ua} [Field k] [CommRing A] [Algebra k A]
+    [Algebra.FiniteType k A] {B : Type ub} [CommRing B] [Algebra k B]
+    [Algebra.FiniteType k B]
+    (e : Nonempty (A[X] ≃ₐ[k] B[X]))
+    (hno : ¬ Nonempty (A ≃ₐ[k] B)) :
+    ¬ IsCancellative.{uk, ua, ub} k A := by
+  intro hc
+  exact hno (hc (B := B) e)
+
+/-! Specialized shape of the missing positive-characteristic witness. -/
+theorem counterexample_specialization
+    (p : ℕ) [Fact p.Prime] {ι : Type u} [Fintype ι]
+    (hι : Fintype.card ι = 3) {B : Type v} [CommRing B]
+    [Algebra (ZMod p) B] [Algebra.FiniteType (ZMod p) B]
+    (e : Nonempty
+      ((MvPolynomial ι (ZMod p))[X] ≃ₐ[ZMod p] B[X]))
+    (hno : ¬ Nonempty (MvPolynomial ι (ZMod p) ≃ₐ[ZMod p] B)) :
+    FrozenStatement.{u, v} p hι := by
+  exact not_cancellative_of_counterexample e hno
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003504
