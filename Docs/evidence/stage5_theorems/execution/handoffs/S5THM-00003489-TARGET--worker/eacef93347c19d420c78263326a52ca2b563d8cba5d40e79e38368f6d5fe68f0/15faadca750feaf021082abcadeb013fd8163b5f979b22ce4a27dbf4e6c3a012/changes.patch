+  |   φ ⋏ ψ => s!"({format φ} ∧ {format ψ})"
+  |   φ ⋎ ψ => s!"({format φ} ∨ {format ψ})"
+  |   φ 🡒 ψ => s!"({format φ} → {format ψ})"
+  | iff φ ψ => s!"({format φ} ↔ {format ψ})"
