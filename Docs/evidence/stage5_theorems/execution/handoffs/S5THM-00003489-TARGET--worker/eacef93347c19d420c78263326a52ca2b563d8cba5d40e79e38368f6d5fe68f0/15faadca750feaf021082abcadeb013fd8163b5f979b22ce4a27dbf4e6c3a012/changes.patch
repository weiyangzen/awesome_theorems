+        | isTrue hq  => isTrue (hp ▸ hq ▸ rfl)
+        | isFalse hq => isFalse (by simp [hp, hq, and_inj])
+      | isFalse hp => isFalse (by simp [hp, and_inj])
+  | φ ⋎ ψ, χ => by
+    cases χ using cases' <;> try { simp; exact isFalse not_false }
+    case hor φ' ψ' =>
