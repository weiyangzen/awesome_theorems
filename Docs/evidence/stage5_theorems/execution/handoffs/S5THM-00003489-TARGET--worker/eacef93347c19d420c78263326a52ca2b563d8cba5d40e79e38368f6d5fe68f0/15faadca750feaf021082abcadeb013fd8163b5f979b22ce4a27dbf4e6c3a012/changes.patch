+@[simp, grind =] lemma complexity_and : complexity (φ ⋏ ψ) = max φ.complexity ψ.complexity + 1 := rfl
+@[simp, grind =] lemma complexity_or : complexity (φ ⋎ ψ) = max φ.complexity ψ.complexity + 1 := rfl
