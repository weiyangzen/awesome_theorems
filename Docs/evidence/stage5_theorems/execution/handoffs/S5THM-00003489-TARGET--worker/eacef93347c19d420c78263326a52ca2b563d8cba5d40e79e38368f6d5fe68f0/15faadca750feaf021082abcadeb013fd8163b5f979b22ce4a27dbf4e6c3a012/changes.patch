+
+structure CompatibleHypInfo where
+  𝓢 : Expr
+  WT : Expr
+  φ : Lit
+  proof : Expr
+
+def HypInfo.toCompatible (h : HypInfo) : M CompatibleHypInfo := do
+  let c ← read
+  if (← isDefEq (← whnf h.F) (← whnf c.F)) && (← isDefEq (← whnf h.S) (← whnf c.S)) && (← isDefEq (← whnf h.E) (← whnf c.E)) then
