+private lemma foundationKT_to_source_prf {φ : LO.Modal.Formula Nat} :
+    LO.Modal.Hilbert.Normal LO.Modal.KT.axioms φ → KTProof ∅ (fromFoundation φ) := by
+  intro h
+  have hp : LO.Modal.Hilbert.Normal LO.Modal.KT.axioms ⊢ φ := ⟨⟨h⟩⟩
+  refine LO.Modal.Hilbert.Normal.rec! (motive := fun φ _ => KTProof ∅ (fromFoundation φ))
+    (axm := ?_) (mdp := ?_) (nec := ?_) (implyK := ?_) (implyS := ?_) (ec := ?_) hp
+  · intro _ s hAx
+    rcases hAx with (rfl | rfl)
+    · let f : Substitution := fun a => fromFoundation (s a)
+      have hk : KProof ∅ (subst f
+          (Formula.Nec (Formula.Imp (Formula.Atom 0) (Formula.Atom 1)) ~>
+            Formula.Nec (Formula.Atom 0) ~> Formula.Nec (Formula.Atom 1))) :=
+        KProof.subst_empty (KProof.distr : KProof ∅
+          (Formula.Nec (Formula.Imp (Formula.Atom 0) (Formula.Atom 1)) ~>
+            Formula.Nec (Formula.Atom 0) ~> Formula.Nec (Formula.Atom 1))) f
+      exact KTProof.lift_K (by simpa [fromFoundation_subst, f, LO.Modal.Axioms.K] using hk)
+    · let f : Substitution := fun a => fromFoundation (s a)
+      have ht : KTProof ∅ (subst f (fromFoundation (LO.Modal.Axioms.T (.atom 0)))) :=
+        KTProof.subst_empty (KTProof.axT : KTProof ∅ (Formula.Nec (Formula.Atom 0) ~> Formula.Atom 0)) f
+      simpa [fromFoundation_subst, f, LO.Modal.Axioms.T] using ht
+  · intro _ _ _ _ ih₁ ih₂
+    exact KTProof.mp ih₁ ih₂
+  · intro _ _ ih
+    exact KTProof.nec ih
+  · exact KTProof.lift_K KProof.ax1
+  · exact KTProof.lift_K KProof.ax2
+  · exact KTProof.lift_K KProof.ax3
