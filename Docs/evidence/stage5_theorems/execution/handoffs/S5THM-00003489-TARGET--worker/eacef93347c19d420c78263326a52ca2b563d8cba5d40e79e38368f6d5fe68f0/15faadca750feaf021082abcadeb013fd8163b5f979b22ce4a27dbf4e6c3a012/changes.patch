+        obtain ⟨i, hi, rfl⟩ := hψ;
+        apply Context.by_axm!;
+        simp only [Finset.coe_image, Finset.coe_range, Set.mem_image, Set.mem_Iio];
+        use i + 1;
+        constructor;
+        . omega;
+        . simp;
+    | implyK! | implyS! | ec! =>
+      use ∅, 0;
+      constructor;
+      . simp;
+      . apply normal_provable_of_K_provable;
+        apply C!_of_conseq!;
+        simp;
+  . rintro ⟨Γ, n, hΓ, hφ⟩;
+    apply (GlobalConsequence.thm! hφ) ⨀ _;
+    apply FConj!_iff_forall_provable.mpr;
+    intro ψ hψ;
+    simp only [Finset.mem_image, Finset.mem_range] at hψ;
+    obtain ⟨i, hi, rfl⟩ := hψ;
+    apply multinec!;
+    apply FConj!_iff_forall_provable.mpr;
+    intro ψ hψ;
+    apply GlobalConsequence.ctx!;
+    apply hΓ;
+    simpa;
+
+end
+
+end GlobalConsequence
+
+end LO.Modal
+end
