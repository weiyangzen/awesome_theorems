+lemma source_boxdot_preimage_subset (L : NormalModalLogic)
+    (H : ∀ φ, proves L (t φ) ↔ proves KT φ) :
+    LO.Modal.Logic.boxdot_preimage (sourceLogic L) ⊆ LO.Modal.KT := by
+  intro φ hφ
+  have hboxmem : φᵇ ∈ sourceLogic L :=
+    (LO.Modal.Logic.iff_provable (L := sourceLogic L) (φ := φᵇ)).mp hφ.2
+  change proves L (fromFoundation (φᵇ)) at hboxmem
+  have hbox : proves L (fromFoundation (φᵇ)) := hboxmem
+  have himpK : KProof ∅ (fromFoundation (φᵇ) ~> t (fromFoundation φ)) :=
+    foundation_boxdot_to_source φ
+  have himpL : proves L (fromFoundation (φᵇ) ~> t (fromFoundation φ)) := L.extK himpK
+  have ht : proves L (t (fromFoundation φ)) := L.mp hbox himpL
