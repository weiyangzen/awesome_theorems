+@[grind =]
+lemma doubleton_subset [DecidableEq α] : ({a, b} : Finset α) ⊆ s ↔ a ∈ s ∧ b ∈ s := by
+  constructor;
+  . intro h;
+    have ⟨ha, hb⟩ := Finset.insert_subset_iff.mp h;
+    tauto;
+  . rintro ⟨ha, hb⟩;
+    apply Finset.insert_subset_iff.mpr;
+    constructor;
+    . assumption;
+    . simpa;
