+@[simp] lemma adjunctiveSet_set (s : Set α) : AdjunctiveSet.set s = s := rfl
+
+@[simp] lemma adjunctiveSet_finite_iff (s : Set α) : AdjunctiveSet.Finite s ↔ s.Finite := by simp [AdjunctiveSet.Finite]
+
+end Set
