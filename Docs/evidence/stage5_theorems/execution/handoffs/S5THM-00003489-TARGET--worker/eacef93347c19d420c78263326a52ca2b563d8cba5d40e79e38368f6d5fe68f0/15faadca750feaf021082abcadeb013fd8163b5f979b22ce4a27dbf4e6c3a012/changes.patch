+lemma foundationK_to_source {φ : LO.Modal.Formula Nat} (h : LO.Modal.K ⊢ φ) :
+    KProof ∅ (fromFoundation φ) := foundationK_to_source_prf h.some.down
+
+lemma foundation_boxdot_iff_tFoundation (φ : LO.Modal.Formula Nat) :
+    LO.Modal.K ⊢ φᵇ 🡘 tFoundation φ := by
+  induction φ using LO.Modal.Formula.rec' with
+  | hfalsum => simpa [LO.Modal.Formula.boxdotTranslate, tFoundation,
+      LO.Modal.Formula.falsum_eq] using (LO.Entailment.E!_id (𝓢 := LO.Modal.K) (φ := (⊥ : LO.Modal.Formula Nat)))
+  | hatom a => simp [LO.Modal.Formula.boxdotTranslate, tFoundation]
+  | himp φ ψ ihφ ihψ =>
+      simp only [LO.Modal.Formula.boxdotTranslate, tFoundation]
+      exact LO.Entailment.ECC!_of_E!_of_E! ihφ ihψ
+  | hbox φ ih =>
+      simp only [LO.Modal.Formula.boxdotTranslate, tFoundation]
+      have hb : LO.Modal.K ⊢ (□φᵇ) 🡘 (□tFoundation φ) :=
+        LO.Modal.Entailment.box_iff! ih
+      have hc : LO.Modal.K ⊢ (φᵇ ⋏ □φᵇ) 🡘 (tFoundation φ ⋏ □tFoundation φ) :=
+        LO.Entailment.EKK!_of_E!_of_E! ih hb
+      have hs : LO.Modal.K ⊢ (tFoundation φ ⋏ □tFoundation φ) 🡘
+          (□tFoundation φ ⋏ tFoundation φ) := by
+        apply LO.Entailment.E!_intro
+        · exact LO.Entailment.CKK!
+        · exact LO.Entailment.CKK!
+      exact LO.Entailment.E!_trans hc hs
