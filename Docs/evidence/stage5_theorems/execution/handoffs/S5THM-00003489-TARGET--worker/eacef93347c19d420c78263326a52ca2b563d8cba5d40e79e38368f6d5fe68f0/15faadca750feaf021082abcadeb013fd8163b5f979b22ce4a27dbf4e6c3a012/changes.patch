+lemma foundationKT_to_source {φ : LO.Modal.Formula Nat} (h : LO.Modal.KT ⊢ φ) :
+    KTProof ∅ (fromFoundation φ) := foundationKT_to_source_prf h.some.down
+
+private lemma foundationK_to_source_prf {φ : LO.Modal.Formula Nat} :
+    LO.Modal.Hilbert.Normal LO.Modal.K.axioms φ → KProof ∅ (fromFoundation φ) := by
+  intro h
+  have hp : LO.Modal.Hilbert.Normal LO.Modal.K.axioms ⊢ φ := ⟨⟨h⟩⟩
+  refine LO.Modal.Hilbert.Normal.rec! (motive := fun φ _ => KProof ∅ (fromFoundation φ))
+    (axm := ?_) (mdp := ?_) (nec := ?_) (implyK := ?_) (implyS := ?_) (ec := ?_) hp
+  · intro _ s hAx
+    rcases hAx with rfl
+    let f : Substitution := fun a => fromFoundation (s a)
+    have hk : KProof ∅ (Adapter.subst f
+        (Formula.Nec (Formula.Imp (Formula.Atom 0) (Formula.Atom 1)) ~>
+          Formula.Nec (Formula.Atom 0) ~> Formula.Nec (Formula.Atom 1))) :=
+      KProof.subst_empty (KProof.distr : KProof ∅
+        (Formula.Nec (Formula.Imp (Formula.Atom 0) (Formula.Atom 1)) ~>
+          Formula.Nec (Formula.Atom 0) ~> Formula.Nec (Formula.Atom 1))) f
+    simpa [fromFoundation_subst, f, LO.Modal.Axioms.K] using hk
+  · intro _ _ _ _ ih₁ ih₂
+    exact KProof.mp ih₁ ih₂
+  · intro _ _ ih
+    exact KProof.nec ih
+  · exact KProof.ax1
+  · exact KProof.ax2
+  · exact KProof.ax3
