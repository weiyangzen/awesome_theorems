+structure Model extends Frame where
+  Val : Valuation toFrame
+instance : CoeSort Model Type := ⟨λ M => M.toFrame.World⟩
+instance : CoeFun (Model) (λ M => ℕ → M.World → Prop) := ⟨fun m => m.Val⟩
