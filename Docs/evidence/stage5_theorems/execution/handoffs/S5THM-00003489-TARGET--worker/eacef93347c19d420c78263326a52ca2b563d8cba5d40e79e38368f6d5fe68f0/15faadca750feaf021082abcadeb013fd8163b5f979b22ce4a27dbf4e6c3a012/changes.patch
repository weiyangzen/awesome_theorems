+-- FOUNDATION-VENDORED-INSERTION-POINT
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003489
+
+/-!
+  The source/Foundation adapter below is deliberately explicit.  It gives a
+  structural bijection between the frozen source syntax and the vendored
+  Foundation syntax, then replays both directions of the Hilbert calculi.
+-/
+namespace Adapter
+
+abbrev FoundationFormula := LO.Modal.Formula Nat
+
+def toFoundation : Formula → FoundationFormula
+  | .Atom a => .atom a
+  | .Falsum => .falsum
+  | .Imp φ ψ => .imp (toFoundation φ) (toFoundation ψ)
+  | .Nec φ => .box (toFoundation φ)
+
+def fromFoundation : FoundationFormula → Formula
+  | .atom a => .Atom a
+  | .falsum => .Falsum
+  | .imp φ ψ => .Imp (fromFoundation φ) (fromFoundation ψ)
+  | .box φ => .Nec (fromFoundation φ)
+
+@[simp] lemma from_to (φ : Formula) : fromFoundation (toFoundation φ) = φ := by
+  induction φ <;> simp_all [toFoundation, fromFoundation]
+
+@[simp] lemma to_from (φ : FoundationFormula) : toFoundation (fromFoundation φ) = φ := by
+  induction φ <;> simp_all [toFoundation, fromFoundation]
+
+private lemma sourceK_to_foundation_aux {Γ : Set Formula} {φ : Formula}
+    (h : KProof Γ φ) : Γ = ∅ → LO.Modal.K ⊢ toFoundation φ := by
+  induction h with
+  | ax h =>
+    intro hΓ
+    simp [hΓ] at h
+  | ax1 =>
+    intro _
+    exact LO.Entailment.implyK! (𝓢 := LO.Modal.K)
+  | ax2 =>
+    intro _
+    exact LO.Entailment.implyS! (𝓢 := LO.Modal.K)
+  | ax3 =>
+    intro _
+    exact LO.Entailment.elim_contra! (𝓢 := LO.Modal.K)
+  | mp _ _ ih₁ ih₂ =>
+    intro hΓ
+    exact LO.Entailment.mdp! (ih₁ hΓ) (ih₂ hΓ)
+  | nec _ ih =>
+    intro _
+    exact LO.Modal.Entailment.nec! (ih rfl)
+  | distr =>
+    intro _
+    exact LO.Modal.Entailment.axiomK! (𝓢 := LO.Modal.K)
+
+lemma sourceK_to_foundation {φ : Formula} (h : KProof ∅ φ) : LO.Modal.K ⊢ toFoundation φ :=
+  sourceK_to_foundation_aux h rfl
+
+private lemma sourceKT_to_foundation_aux {Γ : Set Formula} {φ : Formula}
+    (h : KTProof Γ φ) : Γ = ∅ → LO.Modal.KT ⊢ toFoundation φ := by
+  induction h with
+  | lift_K h =>
+    intro hΓ
+    apply LO.Entailment.WeakerThan.pbl (𝓢 := LO.Modal.K) (𝓣 := LO.Modal.KT)
+    apply sourceK_to_foundation
+    simpa [hΓ] using h
+  | axT =>
+    intro _
+    exact LO.Modal.Entailment.axiomT! (𝓢 := LO.Modal.KT)
+  | mp _ _ ih₁ ih₂ =>
+    intro hΓ
+    exact LO.Entailment.mdp! (ih₁ hΓ) (ih₂ hΓ)
+  | nec _ ih =>
+    intro _
+    exact LO.Modal.Entailment.nec! (ih rfl)
+
+lemma sourceKT_to_foundation {φ : Formula} (h : KTProof ∅ φ) : LO.Modal.KT ⊢ toFoundation φ :=
+  sourceKT_to_foundation_aux h rfl
+
+def Substitution := Nat → Formula
+
+def subst (s : Substitution) : Formula → Formula
+  | .Atom a => s a
+  | .Falsum => .Falsum
+  | .Imp φ ψ => .Imp (subst s φ) (subst s ψ)
+  | .Nec φ => .Nec (subst s φ)
+
+lemma KProof.subst {Γ : Set Formula} {φ : Formula} (h : KProof Γ φ) (s : Substitution) :
+    KProof (subst s '' Γ) (subst s φ) := by
+  induction h with
+  | ax h => exact KProof.ax ⟨_, h, rfl⟩
+  | ax1 => exact KProof.ax1
+  | ax2 => exact KProof.ax2
+  | ax3 => exact KProof.ax3
+  | mp _ _ ih₁ ih₂ => exact KProof.mp ih₁ ih₂
+  | nec _ ih => simpa using (KProof.nec (by simpa using ih))
+  | distr => exact KProof.distr
+
+lemma KTProof.subst {Γ : Set Formula} {φ : Formula} (h : KTProof Γ φ) (s : Substitution) :
+    KTProof (subst s '' Γ) (subst s φ) := by
+  induction h with
+  | lift_K h => exact KTProof.lift_K (KProof.subst h s)
+  | axT => exact KTProof.axT
+  | mp _ _ ih₁ ih₂ => exact KTProof.mp ih₁ ih₂
+  | nec _ ih => simpa using (KTProof.nec (by simpa using ih))
+
+lemma KProof.subst_empty {φ : Formula} (h : KProof ∅ φ) (s : Substitution) :
+    KProof ∅ (Adapter.subst s φ) := by simpa using KProof.subst h s
+
+lemma KTProof.subst_empty {φ : Formula} (h : KTProof ∅ φ) (s : Substitution) :
+    KTProof ∅ (Adapter.subst s φ) := by simpa using KTProof.subst h s
+
+lemma toFoundation_subst (s : Substitution) (φ : Formula) :
+    LO.Modal.Formula.subst (fun a => toFoundation (s a)) (toFoundation φ) = toFoundation (subst s φ) := by
+  induction φ <;> simp [LO.Modal.Formula.subst, subst, toFoundation,
+    LO.Modal.Formula.imp_eq, LO.Modal.Formula.box_eq, LO.Modal.Formula.falsum_eq, *]
+
+lemma fromFoundation_subst (s : LO.Modal.Substitution Nat) (φ : LO.Modal.Formula Nat) :
+    fromFoundation (LO.Modal.Formula.subst s φ) =
+      subst (fun a => fromFoundation (s a)) (fromFoundation φ) := by
+  induction φ <;> simp [LO.Modal.Formula.subst, subst, fromFoundation,
+    LO.Modal.Formula.imp_eq, LO.Modal.Formula.box_eq, LO.Modal.Formula.falsum_eq, *]
+
+def tFoundation : LO.Modal.Formula Nat → LO.Modal.Formula Nat
+  | .atom a => .atom a
+  | .falsum => .falsum
+  | .imp φ ψ => tFoundation φ 🡒 tFoundation ψ
+  | .box φ => (□tFoundation φ) ⋏ tFoundation φ
+
+lemma toFoundation_t (φ : Formula) : toFoundation (t φ) = tFoundation (toFoundation φ) := by
+  induction φ <;> simp [t, toFoundation, tFoundation, Conj,
+    LO.Modal.Formula.imp_eq, LO.Modal.Formula.box_eq, LO.Modal.Formula.falsum_eq,
+    LO.Modal.Formula.and_eq, *]
