+  |      ∼φ => "(¬" ++ toStr φ ++ ")"
+  |   φ ⋏ ψ => "(" ++ toStr φ ++ " ∧ " ++ toStr ψ ++ ")"
+  |   φ ⋎ ψ => "(" ++ toStr φ ++ " ∨ "  ++ toStr ψ ++ ")"
+  |   φ 🡒 ψ => "(" ++ toStr φ ++ " → "  ++ toStr ψ ++ ")"
