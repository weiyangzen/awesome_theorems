+import Mathlib
+
+/-!
+# S5-CLM-00003489 — exact statement
+
+This module replays the definitions surrounding the frozen declaration
+`Arxiv.«1308.0994».BoxdotConjecture` at Formal Conjectures revision
+`2270d31e8dd611521f979de6d86da364930b7669`.  Only the enclosing namespace is
+changed, so the package can be built independently of the source file whose
+theorem body is an unresolved provider placeholder.
+-/
+
+namespace AwesomeTheorems.Stage5.Theorems.S5_CLM_00003489
+
+/-- Propositional modal formulas, matching the frozen source declaration. -/
+inductive Formula : Type
+  | Atom : Nat → Formula
+  | Falsum : Formula
+  | Imp : Formula → Formula → Formula
+  | Nec : Formula → Formula
+  deriving DecidableEq
+
+open Formula
+
+scoped notation "⊥" => Falsum
+infixr:80 " ~> " => Formula.Imp
+scoped notation:max " ~ " φ => φ ~> ⊥
+scoped prefix:95 "□" => Nec
+
+/-- Conjunction in the implication/falsum basis used by the source. -/
+@[reducible]
+def Conj (α β : Formula) : Formula := ~(α ~> ~β)
+
+scoped infixr:85 " & " => Conj
+
+/-- The source's boxdot translation. -/
+def t (φ : Formula) : Formula :=
+  match φ with
+  | α ~> β => t α ~> t β
+  | □α => □t α & t α
+  | _ => φ
+
+scoped prefix:95 "■" => t
+
+/-- Hilbert derivability for modal logic K, exactly as in the frozen source. -/
+inductive KProof : Set Formula → Formula → Prop
+  | ax {Γ} {α} (h : α ∈ Γ) : KProof Γ α
+  | ax1 {Γ} {α β} : KProof Γ (α ~> β ~> α)
+  | ax2 {Γ} {α β γ} : KProof Γ ((α ~> β ~> γ) ~> (α ~> β) ~> (α ~> γ))
+  | ax3 {Γ} {α β} : KProof Γ (((~α) ~> (~β)) ~> (β ~> α))
+  | mp {Γ} {α β} (_ : KProof Γ (α ~> β)) (_ : KProof Γ α) : KProof Γ β
+  | nec {Γ} {α} (_ : KProof ∅ α) : KProof Γ (□α)
+  | distr {Γ} {α β} : KProof Γ (□(α ~> β) ~> □α ~> □β)
+
+/-- Hilbert derivability for KT, exactly as in the frozen source. -/
+inductive KTProof : Set Formula → Formula → Prop
+  | lift_K {Γ} {α} (h : KProof Γ α) : KTProof Γ α
+  | axT {Γ} {α} : KTProof Γ (□α ~> α)
+  | mp {Γ} {α β} (_ : KTProof Γ (α ~> β)) (_ : KTProof Γ α) : KTProof Γ β
+  | nec {Γ} {α} (_ : KTProof ∅ α) : KTProof Γ (□α)
+
+/-- KT extends K. -/
+lemma KTExtendsK {Γ φ} (h : KProof Γ φ) : KTProof Γ φ :=
+  KTProof.lift_K h
+
+/-- A normal modal logic in the representation of the frozen source. -/
+structure NormalModalLogic : Type where
+  thms : Set Formula
+  extK : ∀ {φ}, KProof ∅ φ → φ ∈ thms
+  mp : ∀ {φ ψ}, φ ∈ thms → (φ ~> ψ) ∈ thms → ψ ∈ thms
+  nec : ∀ {φ}, φ ∈ thms → □φ ∈ thms
+
+/-- Membership/provability notation from the source. -/
+def proves (L : NormalModalLogic) (φ : Formula) := φ ∈ L.thms
+
+scoped infixr:85 " ⊢ " => proves
+scoped notation L " ⊆ " L' =>
+  NormalModalLogic.thms L ⊆ NormalModalLogic.thms L'
+
+/-- The normal logic whose theorems are the empty-context KT proofs. -/
+def KT : NormalModalLogic := by
+  constructor
+  case thms => exact {φ | KTProof ∅ φ}
+  case extK =>
+    intro _ h
+    exact KTExtendsK h
+  case mp =>
+    intro φ ψ h₁ h₂
+    exact KTProof.mp h₂ h₁
+  case nec =>
+    intro φ h
+    exact KTProof.nec h
+
+/-- The exact proposition carried by the frozen declaration type. -/
+def SourceStatement : Prop :=
+  ∀ (L : NormalModalLogic), (∀ φ, L ⊢ ■φ ↔ KT ⊢ φ) → L ⊆ KT
+
+/-- The local canonical proposition; it is definitionally the source proposition. -/
+abbrev CanonicalStatement : Prop := SourceStatement
+
+/-- Forward half of the statement crosswalk. -/
+def sourceToCanonical : SourceStatement → CanonicalStatement := id
+
+/-- Reverse half of the statement crosswalk. -/
+def canonicalToSource : CanonicalStatement → SourceStatement := id
+
+example : SourceStatement ↔ CanonicalStatement := Iff.rfl
+
+/-- Byte-stable source declaration text retained for the crosswalk ledger. -/
+def frozenDeclarationText : String :=
+  "theorem BoxdotConjecture (L : NormalModalLogic) (H : ∀ φ, L ⊢ ■ φ ↔ KT ⊢ φ) : L ⊆ KT"
+
+/-- The elaborated source type in the provider's normalized printer form. -/
+def frozenDeclarationType : String :=
+  "(L : NormalModalLogic) (H : ∀ φ, L ⊢ ■ φ ↔ KT ⊢ φ) : L ⊆ KT"
+
+end AwesomeTheorems.Stage5.Theorems.S5_CLM_00003489
