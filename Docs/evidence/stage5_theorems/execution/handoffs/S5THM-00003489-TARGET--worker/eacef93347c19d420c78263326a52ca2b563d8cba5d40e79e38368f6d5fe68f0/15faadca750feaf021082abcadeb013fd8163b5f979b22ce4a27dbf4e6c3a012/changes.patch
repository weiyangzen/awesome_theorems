+    exact ⟨sourceLogic_mem_of_K L (by exact ⟨LO.Entailment.and₁⟩)⟩
+  and₂ := by
+    exact ⟨sourceLogic_mem_of_K L (by exact ⟨LO.Entailment.and₂⟩)⟩
+  and₃ := by
+    exact ⟨sourceLogic_mem_of_K L (by exact ⟨LO.Entailment.and₃⟩)⟩
+  or₁ := by
+    exact ⟨sourceLogic_mem_of_K L (by exact ⟨LO.Entailment.or₁⟩)⟩
+  or₂ := by
+    exact ⟨sourceLogic_mem_of_K L (by exact ⟨LO.Entailment.or₂⟩)⟩
+  or₃ := by
+    exact ⟨sourceLogic_mem_of_K L (by exact ⟨LO.Entailment.or₃⟩)⟩
+  dne := by
