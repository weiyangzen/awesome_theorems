+lemma boxdotConjecture_translation_step
+    {Formula : Type*} {L : Set Formula} {boxdot : Formula → Formula}
+    (translation_closed : Set.MapsTo boxdot L L) {φ : Formula}
+    (hφ : φ ∈ L) :
+    boxdot φ ∈ L := by
+  exact translation_closed hφ
