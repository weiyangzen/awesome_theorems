+theorem BoxdotInclusion
+    {Formula : Type*}
+    (contains : Formula → Prop)
+    (boxdot : Formula → Formula)
+    (kt : Formula → Prop)
+    (faithful : ∀ φ, contains (boxdot φ) ↔ kt φ)
