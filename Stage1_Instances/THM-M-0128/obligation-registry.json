  "obligation_statements": {
    "M0128-ROOT-IDENTITY": "Identify one immutable source-authorized formulation of Shimura reciprocity and prove exactly its CM-special-point Artin/reflex-norm compatibility claim.",
    "M0128-S-SOURCE": "Bind an immutable edition and pinpoint theorem passage, incorporated definitions, hypotheses, corrections, errata, translation, and independent source review.",
    "M0128-S-CLAIM": "Freeze the CM datum, reflex field, special point, canonical model, idele or idele class, ordered binders, hypotheses, and exact conclusion.",
    "M0128-S-CONVENTIONS": "Fix arithmetic versus geometric Artin reciprocity, left versus right Galois and reflex actions, inverse placement, reflex-norm variance, and quotient direction.",
    "M0128-S-BOUNDARY": "Classify trivial ideles, stabilizers, connected components, level structures, degenerate CM data, and equality-versus-orbit boundaries authorized by the exact source.",
    "M0128-S-TRANSPORT": "Prove every credited direction between the exact source formulation and the canonical Lean encoding, binding both statement fingerprints.",
    "M0128-S-FOUNDATION": "Freeze logic, choice, quotients, extensionality, kernel, dependency, computation, and accepted-axiom policy for the exact target.",
    "M0128-N-IDELIC": "Normalize the selected idele or idele-class representative and prove that the Artin and reflex-norm actions descend through every quotient used by the source.",
    "M0128-N-ACTIONS": "Normalize Artin/Galois and reflex-norm actions to one declared handedness and prove all inverse and composition laws needed for comparison.",
    "M0128-N-LOCAL-GLOBAL": "Reduce the global idelic compatibility claim to the exact local or finite-place data used by the approved source and reconstruct the global action.",
    "M0128-B-TRIVIAL": "Prove the exact reciprocity conclusion for the identity idele and every source-authorized stabilizer or level-trivial action case.",
    "M0128-B-GENERIC": "Prove the special-point compatibility equation for every non-boundary idele or idele class in the exact source domain.",
    "M0128-B-RECOMPOSE": "Prove that the boundary and generic branches exhaust the exact domain and that their conclusions recombine to the same canonical target.",
    "M0128-C-REFLEX": "Construct the reflex field and reflex norm for the selected CM datum, including variance, codomain, quotient descent, and independence of auxiliary choices.",
    "M0128-C-ARTIN": "Construct or import the exact global Artin map and its Galois action on the chosen canonical model under the selected normalization.",
    "M0128-C-SPECIAL-POINT": "Construct or import the canonical model, connected component and level data, and the CM special point occurring in the approved theorem.",
    "M0128-C-COMPATIBILITY": "Prove that reflex, Artin, canonical-model, level, representative, and action constructions are well-defined and compatible with every normalization.",
    "M0128-L-REFLEX-DESCENT": "Prove that the reflex norm produces the exact automorphism or correspondence acting on the selected CM special point and descends through the required idelic quotients.",
    "M0128-L-CM-COMPARISON": "Compare the Galois action on the CM object or special point with the action induced by the reflex datum in the exact analytic/algebraic realization used by the source.",
    "M0128-L-RECIPROCITY": "Derive the exact Artin/reflex-norm action compatibility from the reflex-descent and CM-comparison lemmas with all source hypotheses discharged.",
    "M0128-X-IMPORTED": "Inventory every imported declaration, exact type, terminal body, source byte hash, dependency, axiom boundary, and consumer-owned import or transport.",
    "M0128-X-SOURCE": "Map every material premise, transition, branch, and conclusion to pinpoint primary-source records with corrections and independent review.",
    "M0128-X-PROVENANCE": "Close wrapper, alias, terminal declaration, proof body, revision, license, provider bytes, and consumer-byte provenance without transferring acceptance.",
    "M0128-X-TRUST": "Close kernel, axioms, unsafe/oracle use, computation, dependency pins, platform, hermetic replay, and independent verification for actual terminal objects.",
    "M0128-X-READABLE": "Produce independently reviewed readable coverage for every root-critical obligation, formal anchor, assumption, branch, and open boundary.",
    "M0128-X-WORKFLOW": "Obtain dependency-ordered worker, validator, independent-review, master, validation, and release receipts bound to immutable bytes.",
    "M0128-T-BRANCH": "Derive the exact canonical reciprocity conclusion in every source-authorized branch from the completed construction and core-lemma outputs.",
    "M0128-T-TRANSPORT": "Transport normalized branch conclusions through all checked action, quotient, realization, and statement equivalences back to the exact source formulation.",
    "M0128-T-ASSEMBLE": "Consume every exact branch result and transport certificate to yield the complete approved THM-M-0128 root target with no undeclared premise."
  },
