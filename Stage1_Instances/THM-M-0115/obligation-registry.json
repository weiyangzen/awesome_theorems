  "obligation_statements": {
    "M0115-ROOT": "The exact frozen Grothendieck-Riemann-Roch target for every proper morphism of nonsingular quasi-projective varieties over a field and every K_0 class.",
    "M0115-S-TARGET": "Freeze the elaborated public target, expanded target, ordered binders, and exact formula without proof credit.",
    "M0115-S-DOMAIN": "Verify that X and Y are varieties over one field, their structure maps are smooth and quasi-projective, f is over the base, and f is proper.",
    "M0115-S-KZERO": "Construct or integrate the selected scheme K_0 family and prove that it models the Grothendieck group with the relations required by GRR.",
    "M0115-S-CHOW": "Construct or integrate rational Chow homology with its grading, coefficient, and cap-product conventions.",
    "M0115-S-OPERATIONS": "Construct both proper pushforwards, Chern characters, tangent classes, Todd classes, and cap actions with their exact semantic compatibility.",
    "M0115-S-BOUNDARY": "Cover empty varieties and alpha = 0 while excluding singular, non-quasi-projective, nonproper, and non-base-compatible inputs only through the frozen hypotheses.",
    "M0115-S-TRANSPORT": "Check the public alias, expanded target, source cap notation, and any relative or multiplication form in each claimed direction.",
    "M0115-S-FOUNDATION": "Audit the logic, quotient/extensionality principles, imported axioms, computation policy, and complete TCB boundary.",
    "M0115-N-PERFECT": "Normalize alpha to the chosen perfect-complex or vector-bundle representative model and prove independence of that choice.",
    "M0115-N-FACTORIZATION": "Reduce an arbitrary proper morphism in the frozen scope to the factorization or deformation setting used by the selected human proof.",
    "M0115-B-FACTOR": "Split the normalized morphism into the source-proof cases, prove the cases exhaustive, and expose the recomposition theorem.",
    "M0115-C-DEFORMATION": "Construct the deformation or graph-factorization space, its closed/open pieces, and all maps used by the proof.",
    "M0115-C-NORMAL": "Prove well-definedness, flatness or regularity conditions, choice independence, and compatibility of the constructed deformation data.",
    "M0115-L-CHERN": "Establish additivity and functoriality of the Chern character for the exact K_0 and Chow models.",
    "M0115-L-TODD": "Establish the tangent-bundle and Todd-class identities needed for the source and target varieties.",
    "M0115-L-PROJECTION": "Prove the Chow projection formula and compatibility of cap product with proper pushforward.",
    "M0115-L-IMMERSION": "Prove the GRR comparison for the regular closed-immersion case, including the normal-bundle correction.",
    "M0115-L-PROJECTION_CASE": "Prove the GRR comparison for the smooth/projective-bundle projection case selected by the factorization route.",
    "M0115-L-COMPOSE": "Prove that the GRR comparison is stable under composition of the factored morphisms.",
    "M0115-X-MATHLIB": "Bind and audit all pinned mathlib geometry, sheaf, derived, and group-completion substrate actually consumed by later proof work.",
    "M0115-X-EXTERNAL": "Integrate any future external Lean GRR body only after exact-statement transport, placeholder, trust, license, and content-binding checks.",
    "M0115-X-SOURCE": "Map every material definition, reduction, construction, and lemma to pinpoint primary-source records, assumptions, corrections, and independent review.",
    "M0115-X-PROVENANCE": "Resolve every wrapper, terminal declaration, proof-body origin, direct dependency, and transitive trust closure.",
    "M0115-X-EVIDENCE": "Bind exact validation specifications, receipts, expression hashes, source hashes, logs, and invalidation inputs.",
    "M0115-X-TRUST": "Close the foundation, axiom, TCB, computation, offline replay, and reproducibility audits.",
    "M0115-X-READABLE": "Produce unique anchored short and long reconstructions and obtain independent R0 review.",
    "M0115-X-WORKFLOW": "Execute dependency-ordered proof, validation, release, freshness, revocation, and master-acceptance tasks.",
    "M0115-T-RELATIVE": "Derive the relative Chern-character and proper-pushforward comparison from the factored source proof.",
    "M0115-T-TODD_ACTION": "Transport the relative comparison through the target Todd factor to the exact frozen absolute formula.",
    "M0115-T-FORMULA": "Deliver D.Formula alpha for every frozen datum, hypothesis package, and K_0 class.",
    "M0115-T-ASSEMBLE": "Kernel-check the exact child-to-root composition, statement fingerprints, and axiom report without inhabiting open premises."
  },
