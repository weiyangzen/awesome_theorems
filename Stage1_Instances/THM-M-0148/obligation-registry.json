  "obligation_statements": {
    "M0148-ROOT-IDENTITY": "Select one immutable source-authorized theorem branch inside the Mori minimal model programme and prove exactly that proposition, rather than the programme slogan.",
    "M0148-S-SOURCE": "Bind a primary publication, edition, theorem or section locator, incorporated definitions, corrections, errata, translation, and independent source review for the selected branch.",
    "M0148-S-CLAIM": "Freeze the exact field, characteristic, base, dimension, variety or pair, boundary data, singularity and positivity hypotheses, permitted MMP steps, and conclusion.",
    "M0148-S-DOMAIN": "Fix universes, schemes or varieties, morphisms, divisor and numerical-equivalence objects, ordered binders, coercions, and typeclass assumptions for the exact claim.",
    "M0148-S-BOUNDARY": "Classify every source-authorized degenerate or boundary case, including zero-dimensional, already-minimal, non-pseudo-effective, singularity, and relative-base boundaries where applicable.",
    "M0148-S-TRANSPORT": "Prove every credited direction between the source formulation and the canonical Lean encoding, binding both statement fingerprints without weakening either claim.",
    "M0148-S-FOUNDATION": "Freeze logic, choice, quotients, extensionality, computation, kernel, dependency, and accepted-axiom policy for the eventual exact target.",
    "M0148-N-BASE": "Normalize the absolute or relative base and projective or proper morphism setting used by the selected theorem, preserving all source hypotheses.",
    "M0148-N-MODEL": "Normalize the input variety or log pair to the exact normal, Q-factorial, singularity, and boundary presentation required by the source branch.",
    "M0148-N-DIVISOR": "Normalize canonical and boundary divisors, numerical classes, positivity conventions, and scaling data to one declared representation.",
    "M0148-N-TRANSPORT": "Transport the normalized run and its terminal conclusion back to the original source objects with independence of auxiliary choices.",
    "M0148-B-ALREADY-MINIMAL": "Discharge the branch in which the normalized log canonical divisor already satisfies the exact minimality or nefness condition selected by the source.",
    "M0148-B-DIVISORIAL": "Handle every divisorial extremal contraction branch and prove preservation of all invariants needed to continue the selected MMP.",
    "M0148-B-FLIP": "Handle every small-contraction branch by constructing the exact flip or recording the source-authorized failure boundary, then prove preservation of the run invariants.",
    "M0148-B-MORI-FIBRE": "Derive the exact Mori fibre space terminal output in the source-authorized non-pseudo-effective or fibre-type branch.",
    "M0148-B-RECOMPOSE": "Prove that all selected contraction, flip, minimal-model, and fibre-type branches are exhaustive and recombine to the exact canonical target.",
    "M0148-C-CONE": "Construct the relative cone of curves and the K-plus-boundary negative extremal data required by the chosen MMP branch, including every numerical finiteness condition.",
    "M0148-C-CONTRACTION": "Construct the contraction associated to the selected negative extremal ray and prove its universal, relative, and projectivity properties.",
    "M0148-C-FLIP": "Construct a flip for the exact small contraction when required and prove its birational, canonical-ring, and positivity interfaces.",
    "M0148-C-RUN": "Construct the finite, terminating, or explicitly bounded MMP run licensed by the source, with one typed transition record per step.",
    "M0148-C-INVARIANTS": "Prove normality, Q-factoriality, singularity, boundary, discrepancy, numerical, and relative-base invariants for every constructed transition.",
    "M0148-L-CONE": "Prove or import the exact cone theorem and extremal-ray selection package needed by the selected claim.",
    "M0148-L-CONTRACTION": "Prove or import the exact contraction theorem and its divisorial, small, and fibre-type classification interfaces.",
    "M0148-L-FLIP-EXISTENCE": "Prove or import flip existence for precisely the chosen dimension, characteristic, pair, and singularity scope without extrapolating beyond it.",
    "M0148-L-TERMINATION": "Prove the exact termination, special-termination, scaling-termination, or bounded-run assertion required by the selected theorem branch.",
    "M0148-L-MINIMAL-OUTPUT": "Show that a terminal nef branch satisfies the exact minimal-model definition and remains birational to the source input over the declared base.",
    "M0148-L-FIBRE-OUTPUT": "Show that a terminal fibre-type branch satisfies the exact Mori fibre space definition and all relative Picard and negativity conditions.",
    "M0148-X-IMPORTED": "Inventory every imported declaration, exact type, terminal body, source byte hash, dependency, axiom boundary, and consumer-owned import or transport.",
    "M0148-X-SOURCE": "Map every material premise, transition, case split, and conclusion to pinpoint primary-source records with corrections and independent review.",
    "M0148-X-PROVENANCE": "Close wrapper, alias, terminal declaration, proof body, revision, license, provider bytes, and consumer bytes without transferring acceptance.",
    "M0148-X-TRUST": "Close kernel, axioms, unsafe or oracle use, computation, dependency pins, hermetic replay, and independent verification for actual terminal objects.",
    "M0148-X-READABLE": "Produce independently reviewed readable coverage for every root-critical obligation, formal anchor, assumption, branch, transition invariant, and open boundary.",
    "M0148-X-WORKFLOW": "Obtain dependency-ordered worker, semantic-validator, independent-review, master, validation, and release receipts bound to immutable bytes.",
    "M0148-T-MINIMAL": "Derive the exact canonical minimal-model conclusion from a completed source-authorized run and all preservation lemmas.",
    "M0148-T-FIBRE": "Derive the exact canonical Mori fibre space conclusion from the fibre-type terminal branch and all preservation lemmas.",
    "M0148-T-TRANSPORT": "Transport every terminal normalized conclusion through checked birational, divisor, base, and statement equivalences back to the source formulation.",
    "M0148-T-ASSEMBLE": "Consume every exact branch result and transport certificate to yield the complete approved THM-M-0148 root target with no undeclared premise."
  },
