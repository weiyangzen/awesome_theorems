  "obligation_statements": {
    "M0134-ROOT-IDENTITY": "Identify one immutable source-authorized proposition denoted by the Burnside-Young label and prove exactly that proposition without substituting a nearby symmetric-group theorem.",
    "M0134-S-SOURCE": "Bind the primary or approved-authoritative publication, edition, theorem or page locator, incorporated definitions, corrections, errata, translation, and independent source review.",
    "M0134-S-VARIANT": "Distinguish the representation-isomorphism classification, irreducible-character classification, Young's rule, branching rule, orthogonal form, hook-length theorem, and every other plausible Burnside or Young result before selecting one canonical claim.",
    "M0134-S-CLAIM": "Freeze the exact coefficient field, range of n, symmetric-group model, representation model, ordered binders, hypotheses, conclusion, and classification relationship authorized by the source.",
    "M0134-S-DOMAIN": "Fix finite dimensionality, irreducibility, representation isomorphism, quotient and universe conventions, and distinguish representation classes from character classes.",
    "M0134-S-BOUNDARY": "Classify n = 0, n = 1, empty partitions, trivial representations, field-characteristic restrictions, and every other source-authorized degenerate or exceptional case.",
    "M0134-S-TRANSPORT": "Check every credited direction between the exact source claim, the candidate partition-indexing formulation, any character formulation, and the canonical Lean target, binding all fingerprints.",
    "M0134-S-FOUNDATION": "Freeze the logic, classical choice, quotients, extensionality, computation, kernel, dependency, and accepted-axiom policy for the exact target.",
    "M0134-N-PARTITION-SHAPE": "Normalize partitions of n to the Young-diagram shape representation used by the construction and prove the normalization preserves size, order, and all source indexing data.",
    "M0134-N-TABLEAU-ACTION": "Normalize tableau labels, row and column orders, permutation actions, and sign conventions so all tabloid and polytabloid constructions use one declared symmetric-group action.",
    "M0134-N-ISOCLASS": "Normalize irreducible representations to the selected isomorphism-class quotient and prove that the quotient relation and bundled representation equivalence agree.",
    "M0134-N-CHARACTER": "If the admitted source uses irreducible characters, define its exact character space and prove the required characteristic-zero representation-to-character correspondence in the credited direction; otherwise record a reviewed not-applicable decision after source selection.",
    "M0134-N-RETURN": "Transport the normalized partition, tableau, action, and isomorphism-class results back to the exact domains and conventions of the canonical source statement.",
    "M0134-B-DEGENERATE": "Prove the exact classification package in every source-authorized small or degenerate n case, including the relevant partition and trivial-representation identifications.",
    "M0134-B-GENERIC": "For the complementary generic n range, construct the indexed representations and establish irreducibility, pairwise non-isomorphism, and exhaustiveness.",
    "M0134-B-RECOMPOSE": "Prove the boundary and generic branches are exhaustive and recombine their identical output interfaces into one uniform classification package for every authorized n.",
    "M0134-C-TABLEAUX": "Construct standard tableaux of each normalized Young shape, including the exact cell, filling, row, column, and relabeling data required by the proof.",
    "M0134-C-TABLOIDS": "Construct tabloids as row-equivalence classes of fillings, prove the relation is an equivalence, and prove the symmetric-group action descends to the quotient.",
    "M0134-C-PERMUTATION-MODULE": "Construct the complex permutation module on tabloids and prove the linearized symmetric-group action and its representation laws.",
    "M0134-C-SPECHT": "Define polytabloids and the Specht submodule for each partition and prove stability under the symmetric-group action.",
    "M0134-C-REP-BRIDGE": "Bundle each constructed Specht module as a finite-dimensional object of Rep C (Equiv.Perm (Fin n)) and identify it with the intended partition-indexed construction.",
    "M0134-C-IDENTIFY": "Prove that the bundled representation is the source-selected Specht or Young construction for its partition, not an arbitrary representation supplied through a conditional interface.",
    "M0134-C-WELLDEFINED": "Prove all tableau, tabloid, permutation-module, polytabloid, Specht, quotient, and representation constructions are well-defined, compatible, and independent of auxiliary choices.",
    "M0134-L-IRREDUCIBLE": "Prove that every partition-indexed complex Specht representation in the selected construction is irreducible.",
    "M0134-L-NONISOMORPHIC": "Prove that isomorphic constructed irreducible representations have equal partition indices, using a source-authorized separation argument.",
    "M0134-L-EXHAUSTIVE": "Prove every irreducible finite-dimensional complex representation of the selected symmetric group is isomorphic to a constructed partition-indexed representation.",
    "M0134-X-MATHLIB": "Inventory and content-bind every consumed pinned-mathlib declaration for partitions, Young shapes, permutation groups, representations, irreducibility, quotients, and linear algebra.",
    "M0134-X-LEGACY": "Audit the repository legacy statement shape, tableau scaffold, bridge interfaces, conditional proof package, and wrapper bodies without treating their inputs as an inhabited proof package.",
    "M0134-X-EXTERNAL": "Audit every future external formal candidate by immutable revision, exact declaration type, terminal body, license, dependencies, and consumer-owned exact import or checked transport.",
    "M0134-X-SOURCE": "Map every material definition, construction, lemma, branch, and conclusion to pinpoint human-source records and an independent fidelity review.",
    "M0134-X-PROVENANCE": "Resolve wrapper, alias, conclusion, terminal body, dependency, source bytes, and consumer ownership without transferring provider acceptance.",
    "M0134-X-EVIDENCE": "Bind node receipts, validation recipes, declarations, byte hashes, environment outputs, and invalidation inputs for every claimed status or metric.",
    "M0134-X-COMPUTATION": "Classify every use of automation, reflection, finite computation, external code, or certificate and supply an exact replay and trusted-checker boundary where one is used.",
    "M0134-X-TRUST": "Close the Lean kernel, axiom, unsafe, oracle, dependency, toolchain, platform, and reproducibility trust boundary.",
    "M0134-X-READABLE": "Produce and independently review a bidirectionally anchored readable reconstruction for every root-critical obligation, branch, construction, assumption, and open boundary.",
    "M0134-X-WORKFLOW": "Obtain dependency-ordered worker, validator, independent-review, master, validation, and release receipts bound to immutable bytes and the authoritative task state.",
    "M0134-T-PACKAGE": "Assemble the uniform constructed representations, irreducibility witnesses, pairwise separation, and exhaustiveness witnesses into the exact conditional classification package.",
    "M0134-T-BIJECTION": "Derive injectivity and surjectivity on representation isomorphism classes and construct the exact partition-to-class equivalence without double-counting the conditional wrapper.",
    "M0134-T-TRANSPORT": "Transport the classification equivalence through every checked normalization to the exact canonical source and Lean statement fingerprints.",
    "M0134-T-ASSEMBLE": "Consume the exact branch recomposition and checked transport results to yield the complete resolved THM-M-0134 root target."
  },
