/-- The cyclotomic number-field layer available as a concrete mathlib object. -/
abbrev CyclotomicLayer (n : ℕ) :=
  CyclotomicField n ℚ

/-! ## Cyclotomic class-group tower API boundary -/

/--
The concrete cyclotomic `p`-power layer used for the class-group tower.

The index `n` corresponds to the field generated by `p ^ (n + 1)`-st roots of
unity. Starting at `n + 1` avoids the degenerate `0`-th cyclotomic layer while
keeping the tower indexed by natural numbers.
-/
abbrev CyclotomicTowerLayer (p n : ℕ) [Fact p.Prime] :=
  CyclotomicLayer (p ^ (n + 1))

/-- The ring of integers in the `n`-th cyclotomic `p`-power layer. -/
abbrev CyclotomicTowerRingOfIntegers (p n : ℕ) [Fact p.Prime] :=
  NumberField.RingOfIntegers (CyclotomicTowerLayer p n)

/-- The ideal class group of the ring of integers in the `n`-th tower layer. -/
abbrev CyclotomicTowerClassGroup (p n : ℕ) [Fact p.Prime] :=
  ClassGroup (CyclotomicTowerRingOfIntegers p n)

/--
Checked adjacent wrapper: each concrete `p`-power tower layer is cyclotomic over
`ℚ`.

This supplies a repo-local name for the field tower substrate. It does not
construct norm maps on class groups.
-/
theorem cyclotomicTowerLayer_isCyclotomicExtension_mathlib_wrapper
    (p n : ℕ) [Fact p.Prime] :
    letI : Algebra ℚ (CyclotomicTowerLayer p n) :=
      CyclotomicField.algebraBase (p ^ (n + 1)) ℚ ℚ
    IsCyclotomicExtension {p ^ (n + 1)} ℚ (CyclotomicTowerLayer p n) := by
  letI : Algebra ℚ (CyclotomicTowerLayer p n) :=
    CyclotomicField.algebraBase (p ^ (n + 1)) ℚ ℚ
  exact CyclotomicField.isCyclotomicExtension (p ^ (n + 1)) ℚ

/-- Checked wrapper: the class group object exists for every concrete tower layer. -/
theorem cyclotomicTowerClassGroup_nonempty_mathlib_wrapper
    (p n : ℕ) [Fact p.Prime] :
    Nonempty (CyclotomicTowerClassGroup p n) :=
  inferInstance

/--
API boundary for transition maps in the cyclotomic class-group tower.

The final formalization needs the algebraic norm/corestriction maps induced by
the finite extensions between consecutive `p`-power cyclotomic layers. Current
mathlib gives the class-group objects, but this file does not construct those
norm maps; an implementation must provide them together with their mathematical
specification.
-/
structure ClassGroupTowerAPI (p : ℕ) [Fact p.Prime] : Type where
  transitionNorm :
    (n : ℕ) →
      CyclotomicTowerClassGroup p (n + 1) →*
        CyclotomicTowerClassGroup p n
  transitionNormSpec : (n : ℕ) → Prop
  transitionNorm_spec : ∀ n, transitionNormSpec n

/--
The inverse limit of the supplied class groups along the supplied transition
norm maps.

This is a real Lean type once a `ClassGroupTowerAPI` is supplied. It remains an
API boundary because the transition maps themselves are not constructed here.
-/
def ClassGroupTowerInverseLimit {p : ℕ} [Fact p.Prime]
    (tower : ClassGroupTowerAPI p) : Type :=
  { x : (n : ℕ) → CyclotomicTowerClassGroup p n //
      ∀ n, tower.transitionNorm n (x (n + 1)) = x n }

/--
The child-task closure target for the class-group tower API.

This is intentionally stated as nonemptiness of the complete tower API, not as a
proved construction.
-/
def ClassGroupTowerAPITarget : Prop :=
  ∀ (p : ℕ) [Fact p.Prime], Nonempty (ClassGroupTowerAPI p)

/-- The class-group tower API target unfolds to nonemptiness of the concrete API. -/
theorem classGroupTowerAPITarget_iff :
    ClassGroupTowerAPITarget ↔
      ∀ (p : ℕ) [Fact p.Prime], Nonempty (ClassGroupTowerAPI p) :=
  Iff.rfl

/--
Checked interface for characteristic ideals of torsion modules over a candidate
Iwasawa algebra.

This is an API boundary, not a construction: an implementation must supply the
ideal-valued operation and its specification theorem for every torsion module.
-/
structure CharacteristicIdealTheory (Λ : Type uΛ) [CommRing Λ] :
    Type (max uΛ uM + 1) where
  characteristicIdealOfTorsionModule :
    (M : Type uM) → [AddCommGroup M] → [Module Λ M] →
      Module.IsTorsion Λ M → Ideal Λ
  characteristicIdealSpec :
    (M : Type uM) → [AddCommGroup M] → [Module Λ M] →
      Module.IsTorsion Λ M → Ideal Λ → Prop
  characteristicIdeal_spec :
    ∀ (M : Type uM) [AddCommGroup M] [Module Λ M]
      (hM : Module.IsTorsion Λ M),
        characteristicIdealSpec M hM
          (characteristicIdealOfTorsionModule M hM)

/--
Concrete API target for the Iwasawa algebra side over `ℤ_[p]`.

The package deliberately requires topology, a topological-ring structure,
`ℤ_[p]`-algebra structure, noetherian/domain instances, an augmentation ideal,
and characteristic ideals for torsion modules. No term of this structure is
constructed in this file; `S1-M-257.iwasawa-algebra-api` remains open until such
an object is imported or defined and locally validated.
-/
structure IwasawaAlgebraAPI (p : ℕ) [Fact p.Prime] :
    Type (max uΛ uM + 1) where
  Λ : Type uΛ
  [commRing : CommRing Λ]
  [algebraOverPadicIntegers : Algebra ℤ_[p] Λ]
  [topologicalSpace : TopologicalSpace Λ]
  [isTopologicalRing : IsTopologicalRing Λ]
  [noetherianRing : IsNoetherianRing Λ]
  [domain : IsDomain Λ]
  completedGroupAlgebraTopology : Prop
  completedGroupAlgebraTopology_proof : completedGroupAlgebraTopology
  augmentationIdeal : Ideal Λ
  characteristicIdealTheory : CharacteristicIdealTheory.{uΛ, uM} Λ

