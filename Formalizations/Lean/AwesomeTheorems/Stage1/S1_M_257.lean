    Nonempty (ClassGroup (NumberField.RingOfIntegers K)) :=
  inferInstance

/--
Checked adjacent wrapper: mathlib's complex Dirichlet-character completed
L-function functional equation.

This is an analytic-number-theory anchor adjacent to the Iwasawa main
conjecture. It is not a `p`-adic L-function interpolation theorem.
-/
theorem dirichlet_completed_functional_equation_mathlib_wrapper
    {N : ℕ} [NeZero N] {χ : DirichletCharacter ℂ N}
    (hχ : χ.IsPrimitive) (s : ℂ) :
    completedLFunction χ (1 - s) =
      (N : ℂ) ^ (s - 1 / 2) * rootNumber χ * completedLFunction χ⁻¹ s :=
  hχ.completedLFunction_one_sub s

