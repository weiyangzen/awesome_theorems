/-- A finitely additive `ℚ_[p]`-valued distribution on a measurable space. -/
structure PadicDistributionModel (p : ℕ) [Fact p.Prime]
    (CharacterSpace : Type uχ) [MeasurableSpace CharacterSpace] :
    Type uχ where
  mass : Set CharacterSpace → ℚ_[p]
  mass_empty : mass ∅ = 0
  mass_union_of_disjoint :
    ∀ {s t : Set CharacterSpace}, MeasurableSet s → MeasurableSet t →
      Disjoint s t → mass (s ∪ t) = mass s + mass t
  boundednessCondition : Prop
  boundedness_condition : boundednessCondition

/--
API boundary for the `p`-adic measure/distribution and interpolation theorem
needed to construct the cyclotomic `p`-adic L-function.

The `interpolationValue` field is the already-normalized `p`-adic value of the
complex critical L-value after all Euler factors, periods, embeddings, and
algebraicity results have been accounted for. A terminal formalization should
replace it by the explicit normalization theorem for Dirichlet characters.
-/
structure PadicLFunctionAPI (p : ℕ) [Fact p.Prime] : Type (uχ + 1) where
  CharacterSpace : Type uχ
  [characterMeasurableSpace : MeasurableSpace CharacterSpace]
  [characterTopologicalSpace : TopologicalSpace CharacterSpace]
  distribution : PadicDistributionModel p CharacterSpace
  pAdicLFunction : CharacterSpace → ℚ_[p]
  locallyAlgebraicCharacters : Set CharacterSpace
  interpolationValue : CharacterSpace → ℚ_[p]
  interpolationFormula :
    ∀ χ ∈ locallyAlgebraicCharacters,
      pAdicLFunction χ = interpolationValue χ
  measureConstructsLFunction : Prop
  measure_constructs_lfunction : measureConstructsLFunction
  cyclotomicCharacterCompatibility : Prop
  cyclotomic_character_compatibility : cyclotomicCharacterCompatibility

