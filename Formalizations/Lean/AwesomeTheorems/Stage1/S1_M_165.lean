/-!
# S1-M-165 / THM-M-1272: Fountain theorem

This Stage1 artifact records a conservative Lean 4 statement-shape boundary for
the variational Fountain theorem, a multiplicity theorem for even `C^1`
functionals on an infinite-dimensional Hilbert/Banach-type space.

The pinned mathlib snapshot has Frechet derivatives, `ContDiff`, local extremum
critical-point wrappers, Hilbert bases, orthogonal decompositions, and Hilbert
sum infrastructure.  This audit did not find a terminal Fountain theorem,
Palais-Smale compactness package, or minimax critical-point theorem in the local
dependency closure.

The declarations below therefore avoid proof placeholders and false completion
claims.  They normalize the expected critical-point conclusion and keep the hard
compactness/minimax geometry as explicit data.
-/

noncomputable section

open Filter
open scoped Topology

namespace AwesomeTheorems.Stage1.S1_M_165

universe u

variable {E : Type u} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- A point is critical for a real functional when its Frechet derivative vanishes. -/
def CriticalPoint (Phi : E -> ℝ) (x : E) : Prop :=
  fderiv ℝ Phi x = 0

/-- A real number is a critical value of a functional. -/
def CriticalValue (Phi : E -> ℝ) (c : ℝ) : Prop :=
  ∃ x : E, CriticalPoint Phi x ∧ Phi x = c

/-- The critical values are unbounded above. -/
def CriticalValuesUnboundedAbove (Phi : E -> ℝ) : Prop :=
  ∀ A : ℝ, ∃ c : ℝ, CriticalValue Phi c ∧ A ≤ c

/-- Frechet-derivative residual measured by the continuous-linear-map norm. -/
def FrechetResidual
    {X : Type u} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (Phi : X -> ℝ) (x : X) : ℝ :=
  ‖fderiv ℝ Phi x‖

/-- Concrete topological compactness target: a sequence has a convergent subsequence. -/
def HasConvergentSubsequence
    {X : Type u} [TopologicalSpace X] (u : ℕ -> X) : Prop :=
  ∃ x : X, ∃ phi : ℕ -> ℕ,
    StrictMono phi ∧ Tendsto (fun n : ℕ => u (phi n)) atTop (𝓝 x)

/--
A Palais-Smale sequence at level `c`.

This is the standard `PS_c` sequence shape: functional values converge to the
selected level and Frechet derivative norms converge to zero.
-/
structure PalaisSmaleSequence
    {X : Type u} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (Phi : X -> ℝ) (c : ℝ) (u : ℕ -> X) : Prop where
  values_tendsto : Tendsto (fun n : ℕ => Phi (u n)) atTop (𝓝 c)
  derivative_norm_tendsto :
    Tendsto (fun n : ℕ => FrechetResidual Phi (u n)) atTop (𝓝 (0 : ℝ))

/-- Palais-Smale compactness at one fixed critical/minimax level. -/
def PalaisSmaleCompactnessAt
    {X : Type u} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (Phi : X -> ℝ) (c : ℝ) : Prop :=
  ∀ u : ℕ -> X, PalaisSmaleSequence Phi c u -> HasConvergentSubsequence u

/-- Full Palais-Smale compactness, quantified over every real level. -/
def FullPalaisSmaleCompactness
    {X : Type u} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (Phi : X -> ℝ) : Prop :=
  ∀ c : ℝ, PalaisSmaleCompactnessAt Phi c

/-- Bounded functional values along a sequence, expressed without extra APIs. -/
def FunctionalValuesBounded
    {X : Type u} [NormedAddCommGroup X] (Phi : X -> ℝ) (u : ℕ -> X) : Prop :=
  ∃ R : ℝ, ∀ n : ℕ, ‖Phi (u n)‖ ≤ R

/--
A Cerami sequence with bounded functional values.

The derivative condition is the usual `(1 + ‖u_n‖) * ‖Phi'(u_n)‖ -> 0`
variant, stated with the Frechet derivative norm.
-/
structure CeramiSequence
    {X : Type u} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (Phi : X -> ℝ) (u : ℕ -> X) : Prop where
  values_bounded : FunctionalValuesBounded Phi u
  weighted_derivative_norm_tendsto :
    Tendsto
      (fun n : ℕ => (1 + ‖u n‖) * FrechetResidual Phi (u n))
      atTop (𝓝 (0 : ℝ))

/-- Cerami compactness for all bounded-energy Cerami sequences. -/
def CeramiCompactness
    {X : Type u} [NormedAddCommGroup X] [NormedSpace ℝ X]
    (Phi : X -> ℝ) : Prop :=
  ∀ u : ℕ -> X, CeramiSequence Phi u -> HasConvergentSubsequence u

/-- Compactness variants relevant to public Fountain-theorem statement selection. -/
inductive CompactnessRequirement where
  | palaisSmaleAtLevels
  | fullPalaisSmale
  | cerami
deriving DecidableEq, Repr

/--
Compactness input selected for the classical Fountain theorem target.

The public parent target needs `PS_c` at the minimax levels generated by the
Fountain construction.  Full global `PS` is stronger than this target requires,
and Cerami compactness belongs to a generalized/Cerami branch rather than the
selected parent statement.
-/
structure ClassicalFountainCompactness (Phi : E -> ℝ) : Type u where
  minimaxLevel : ℕ -> ℝ
  palaisSmaleAt_minimaxLevel :
    ∀ n : ℕ, PalaisSmaleCompactnessAt Phi (minimaxLevel n)

/-- Machine-checkable compactness decision for `S1-M-165-C004`. -/
def selectedCompactnessRequirement : CompactnessRequirement :=
  .palaisSmaleAtLevels

/-- The selected compactness requirement is `PS_c` at the minimax levels. -/
theorem selectedCompactnessRequirement_eq_psAtLevels :
    selectedCompactnessRequirement = CompactnessRequirement.palaisSmaleAtLevels :=
  rfl

/-- Public-backfill rationale for the compactness decision. -/
def selectedCompactnessRequirementRationale : String :=
  "For the selected classical Bartsch-Willem Fountain theorem target, use " ++
  "Palais-Smale compactness at the minimax levels (`PS_c`).  Do not require " ++
  "full global `PS` for every level in the parent statement, and do not switch " ++
  "the parent to Cerami compactness; Cerami belongs to a generalized/Cerami " ++
  "branch unless a later primary-source audit changes the selected variant."

/--
Abstract Fountain-theorem geometry for an even variational functional.

The usual theorem uses a decomposition by finite-dimensional subspaces and their
closed complements, together with lower barriers on large spheres and escape to
negative values on finite-dimensional parts.  These fields are proposition-valued
because no terminal mathlib minimax/Palais-Smale proof package was found.
-/
structure FountainGeometry (Phi : E -> ℝ) : Type u where
  finiteCore : ℕ -> Submodule ℝ E
  finiteCore_finiteDimensional : ∀ n : ℕ, FiniteDimensional ℝ (finiteCore n)
  complement : ℕ -> Submodule ℝ E
  highSphereRadius : ℕ -> ℝ
  lowBallRadius : ℕ -> ℝ
  highSphereBarrier : Prop
  highSphereBarrier_holds : highSphereBarrier
  finiteDimensionalEscape : Prop
  finiteDimensionalEscape_holds : finiteDimensionalEscape
  splittingCompatibility : Prop
  splittingCompatibility_holds : splittingCompatibility

/--
Hypothesis package for a Fountain theorem statement.

The hard formalization boundary is explicit: the Palais-Smale compactness and
minimax construction are inputs here, not proved by this Stage1 artifact.
-/
structure FountainHypotheses (Phi : E -> ℝ) : Type u where
  c1 : ContDiff ℝ 1 Phi
  even : ∀ x : E, Phi (-x) = Phi x
  geometry : FountainGeometry Phi
  palaisSmaleCompactness : Prop
  palaisSmaleCompactness_holds : palaisSmaleCompactness
  minimaxConstruction : Prop
  minimaxConstruction_holds : minimaxConstruction

/--
Conclusion package for the Fountain theorem: a sequence of critical points whose
critical values tend upward without a finite upper bound.
-/
structure FountainConclusion (Phi : E -> ℝ) : Type u where
  criticalPoint : ℕ -> E
  critical : ∀ n : ℕ, CriticalPoint Phi (criticalPoint n)
  criticalValuesUnbounded : CriticalValuesUnboundedAbove Phi

/--
Normalized Stage1 statement shape for the Fountain theorem over a fixed Hilbert
space and functional.

If the Fountain geometry, Palais-Smale compactness, and minimax package have
been supplied, then the functional has unboundedly many critical values.  This
is a statement boundary, not a terminal proof of the Fountain theorem.
-/
def StatementShape
    (E : Type u) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (Phi : E -> ℝ) : Prop :=
  FountainHypotheses Phi -> Nonempty (FountainConclusion Phi)

/-- The statement shape unfolds to the normalized hypothesis/conclusion package. -/
theorem statementShape_iff
    (E : Type u) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (Phi : E -> ℝ) :
    StatementShape E Phi ↔
      (FountainHypotheses Phi -> Nonempty (FountainConclusion Phi)) :=
  Iff.rfl

/-- Low-risk introduction wrapper for the normalized statement shape. -/
theorem statementShape_intro
    (E : Type u) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]
    (Phi : E -> ℝ)
    (h : FountainHypotheses Phi -> Nonempty (FountainConclusion Phi)) :
    StatementShape E Phi :=
  h

/-- A conclusion package exposes a concrete critical point at every index. -/
theorem FountainConclusion.critical_at
    {Phi : E -> ℝ} (C : FountainConclusion Phi) (n : ℕ) :
    CriticalPoint Phi (C.criticalPoint n) :=
  C.critical n

/-- A conclusion package exposes the indexed critical value. -/
theorem FountainConclusion.critical_value_at
    {Phi : E -> ℝ} (C : FountainConclusion Phi) (n : ℕ) :
    CriticalValue Phi (Phi (C.criticalPoint n)) :=
  ⟨C.criticalPoint n, C.critical n, rfl⟩

/-- A conclusion package exposes the unboundedness of critical values. -/
theorem FountainConclusion.unbounded_critical_values
    {Phi : E -> ℝ} (C : FountainConclusion Phi) :
    CriticalValuesUnboundedAbove Phi :=
  C.criticalValuesUnbounded

/-- Checked mathlib anchor: a local minimum of a real functional is critical. -/
theorem localMin_criticalPoint_anchor
    {Phi : E -> ℝ} {x : E} (h : IsLocalMin Phi x) :
    CriticalPoint Phi x :=
  h.fderiv_eq_zero

/-- Checked mathlib anchor: `C^1` implies continuity. -/
theorem contDiff_one_continuous_anchor
    {Phi : E -> ℝ} (h : ContDiff ℝ 1 Phi) :
    Continuous Phi :=
  h.continuous

/-- Checked mathlib anchor: `C^1` implies Frechet differentiability. -/
theorem contDiff_one_differentiable_anchor
    {Phi : E -> ℝ} (h : ContDiff ℝ 1 Phi) :
    Differentiable ℝ Phi :=
  h.differentiable_one

/-- Checked mathlib anchor: every real Hilbert space admits a Hilbert basis. -/
theorem exists_hilbertBasis_anchor
    (E : Type u) [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E] :
    ∃ (w : Set E) (b : HilbertBasis w ℝ E), ⇑b = ((↑) : w -> E) :=
  exists_hilbertBasis ℝ E

