-/
def selectedFountainDecompositionModel : FountainDecompositionModel :=
  .orthogonalSubmodules

/-- The selected Fountain decomposition model is orthogonal submodules. -/
theorem selectedFountainDecompositionModel_eq_orthogonalSubmodules :
    selectedFountainDecompositionModel =
      FountainDecompositionModel.orthogonalSubmodules :=
  rfl

/--
Concrete mathlib-backed anchor for the selected two-piece orthogonal split.

For a complete submodule `K` of a complete Hilbert space, mathlib supplies the
Hilbert-sum decomposition of `K` and its orthogonal complement `Kᗮ`.
-/
def OrthogonalPairHilbertSum
    (K : Submodule ℝ E) [CompleteSpace E] [CompleteSpace K] : Prop :=
  IsHilbertSum ℝ (fun b : Bool => ↥(cond b K Kᗮ))
    fun b => (cond b K Kᗮ).subtypeₗᵢ

/-- Checked anchor: a complete submodule and its orthogonal complement form a Hilbert sum. -/
theorem orthogonalPairHilbertSum_anchor
    (K : Submodule ℝ E) [CompleteSpace E] [CompleteSpace K] :
    OrthogonalPairHilbertSum K :=
  Submodule.isHilbertSumOrthogonal K

