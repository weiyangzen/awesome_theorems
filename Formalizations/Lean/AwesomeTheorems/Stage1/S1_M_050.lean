/-- The finite symmetric group in the form used by mathlib. -/
abbrev SymmetricGroup (n : Nat) :=
  Equiv.Perm (Fin n)

/-- The bundled category of complex representations of `S_n`. -/
abbrev ComplexRep (n : Nat) : Type 1 :=
  Rep.{0} ℂ (SymmetricGroup n)

/-- Bundled irreducible complex representations of `S_n`. -/
abbrev IrreducibleRep (n : Nat) : Type 1 :=
  { A : ComplexRep n // Representation.IsIrreducible A.ρ }

/-- Isomorphism relation on bundled irreducible representations. -/
def IrreducibleRepIsoRel (n : Nat) (A B : IrreducibleRep n) : Prop :=
  Nonempty ((A : ComplexRep n) ≅ (B : ComplexRep n))

/-- Setoid generated by isomorphism of bundled irreducible representations. -/
instance irreducibleRepIsoSetoid (n : Nat) : Setoid (IrreducibleRep n) where
  r := IrreducibleRepIsoRel n
  iseqv := by
    refine ⟨?_, ?_, ?_⟩
    · intro A
      exact ⟨Iso.refl (A : ComplexRep n)⟩
    · intro A B hAB
      rcases hAB with ⟨eAB⟩
      exact ⟨eAB.symm⟩
    · intro A B C hAB hBC
      rcases hAB with ⟨eAB⟩
      rcases hBC with ⟨eBC⟩
      exact ⟨eAB ≪≫ eBC⟩

/-- Isomorphism classes of irreducible complex representations of `S_n`. -/
abbrev IrreducibleRepIsoClass (n : Nat) : Type 1 :=
  Quotient (irreducibleRepIsoSetoid n)

/-- Statement shape for the Burnside-Young classification.

The expected terminal theorem would construct this equivalence via Specht or
Young-module data and prove irreducibility, exhaustiveness, and pairwise
non-isomorphism.  This file only freezes the Lean 4 target shape.
