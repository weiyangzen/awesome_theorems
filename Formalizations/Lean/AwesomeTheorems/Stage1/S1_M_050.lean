/-! ## Irreducibility, non-isomorphism, exhaustiveness, and final equivalence package. -/

/--
Conditional proof package for the terminal Burnside-Young classification.
The fields make explicit that irreducibility, pairwise non-isomorphism, and
exhaustiveness must all be proved before the `StatementShape` equivalence can
be assembled.
-/
structure BurnsideYoungProofPackage where
  /-- Candidate Specht/Young representation associated to each partition. -/
  specht : ∀ n : Nat, Nat.Partition n → ComplexRep n
  /-- Each constructed representation is irreducible. -/
  irreducible :
    ∀ n : Nat, ∀ lam : Nat.Partition n,
      Representation.IsIrreducible (specht n lam).ρ
  /-- Non-isomorphic partitions give non-isomorphic representations. -/
  pairwise_nonisomorphic :
    ∀ {n : Nat} {lam mu : Nat.Partition n},
      Nonempty (specht n lam ≅ specht n mu) → lam = mu
  /-- Every irreducible representation is isomorphic to one of the constructed representations. -/
  exhaustive :
    ∀ n : Nat, ∀ A : IrreducibleRep n,
      ∃ lam : Nat.Partition n, Nonempty (specht n lam ≅ (A : ComplexRep n))

namespace BurnsideYoungProofPackage

/-- Bundle a package representation with its irreducibility proof. -/
def toIrreducibleRep (P : BurnsideYoungProofPackage) (n : Nat)
    (lam : Nat.Partition n) : IrreducibleRep n :=
  ⟨P.specht n lam, P.irreducible n lam⟩

/-- Map a partition to the isomorphism class of its constructed irreducible representation. -/
def toIsoClass (P : BurnsideYoungProofPackage) (n : Nat)
    (lam : Nat.Partition n) : IrreducibleRepIsoClass n :=
  Quotient.mk' (P.toIrreducibleRep n lam)

/-- Pairwise non-isomorphism gives injectivity on isomorphism classes. -/
theorem toIsoClass_injective (P : BurnsideYoungProofPackage) (n : Nat) :
    Function.Injective (P.toIsoClass n) := by
  intro lam mu h
  have hRel : P.toIrreducibleRep n lam ≈ P.toIrreducibleRep n mu :=
    Quotient.exact h
  exact P.pairwise_nonisomorphic (n := n) (lam := lam) (mu := mu) <| by
    simpa [toIrreducibleRep, IrreducibleRepIsoRel] using hRel

/-- Exhaustiveness gives surjectivity onto isomorphism classes. -/
theorem toIsoClass_surjective (P : BurnsideYoungProofPackage) (n : Nat) :
    Function.Surjective (P.toIsoClass n) := by
  intro q
  refine Quotient.inductionOn' q ?_
  intro A
  rcases P.exhaustive n A with ⟨lam, hIso⟩
  refine ⟨lam, ?_⟩
  have hRel : P.toIrreducibleRep n lam ≈ A := by
    simpa [toIrreducibleRep, IrreducibleRepIsoRel] using hIso
  exact Quotient.sound hRel

/--
The final partition/classification equivalence obtained after the three
classification obligations are supplied.
-/
noncomputable def equivalence (P : BurnsideYoungProofPackage) (n : Nat) :
    Nat.Partition n ≃ IrreducibleRepIsoClass n :=
  Equiv.ofBijective (P.toIsoClass n)
    ⟨P.toIsoClass_injective n, P.toIsoClass_surjective n⟩

/-- A completed proof package would discharge the Stage1 statement shape. -/
theorem statementShape_of_proofPackage (P : BurnsideYoungProofPackage) :
    StatementShape := by
  intro n
  exact ⟨P.equivalence n⟩

end BurnsideYoungProofPackage

