/-! ## Standard-tableau and tabloid proof-package scaffold. -/

/-- A cell of a Young diagram, bundled with its membership proof. -/
abbrev YoungCell (μ : YoungDiagram) : Type :=
  { c : ℕ × ℕ // c ∈ μ }

/-- A tableau filling of shape `μ` by the entries `0, ..., μ.card - 1`. -/
structure TableauFilling (μ : YoungDiagram) where
  /-- Entry assigned to each cell. -/
  entry : YoungCell μ → Fin μ.card
  /-- A tabloid/tableau filling uses each entry exactly once. -/
  bijective_entry : Function.Bijective entry

namespace TableauFilling

instance {μ : YoungDiagram} : CoeFun (TableauFilling μ) (fun _ => YoungCell μ → Fin μ.card) where
  coe T := T.entry

/-- The row index of a Young-diagram cell. -/
def rowIndex {μ : YoungDiagram} (c : YoungCell μ) : ℕ :=
  c.1.1

/-- The column index of a Young-diagram cell. -/
def columnIndex {μ : YoungDiagram} (c : YoungCell μ) : ℕ :=
  c.1.2

@[simp]
theorem rowIndex_mk {μ : YoungDiagram} {c : ℕ × ℕ} (hc : c ∈ μ) :
    rowIndex (⟨c, hc⟩ : YoungCell μ) = c.1 :=
  rfl

@[simp]
theorem columnIndex_mk {μ : YoungDiagram} {c : ℕ × ℕ} (hc : c ∈ μ) :
    columnIndex (⟨c, hc⟩ : YoungCell μ) = c.2 :=
  rfl

end TableauFilling

/--
Standard tableaux of shape `μ`: bijective fillings of the cells by
`Fin μ.card`, strictly increasing along rows and columns.
-/
structure StandardTableau (μ : YoungDiagram) where
  /-- Underlying bijective filling. -/
  filling : TableauFilling μ
  /-- Entries strictly increase left-to-right in each row. -/
  row_strict :
    ∀ {a b : YoungCell μ},
      TableauFilling.rowIndex a = TableauFilling.rowIndex b →
        TableauFilling.columnIndex a < TableauFilling.columnIndex b →
          filling a < filling b
  /-- Entries strictly increase top-to-bottom in each column. -/
  column_strict :
    ∀ {a b : YoungCell μ},
      TableauFilling.columnIndex a = TableauFilling.columnIndex b →
        TableauFilling.rowIndex a < TableauFilling.rowIndex b →
          filling a < filling b

namespace StandardTableau

instance {μ : YoungDiagram} : CoeFun (StandardTableau μ) (fun _ => YoungCell μ → Fin μ.card) where
  coe T := T.filling

/-- Forget a standard tableau to its underlying bijective filling. -/
def toTableauFilling {μ : YoungDiagram} (T : StandardTableau μ) : TableauFilling μ :=
  T.filling

end StandardTableau

/--
Two fillings are row-content equivalent when an entry occurs in the same row in
both fillings.  This is the row-permutation relation whose quotient is a
tabloid.
-/
def RowContentEquivalent {μ : YoungDiagram} (T U : TableauFilling μ) : Prop :=
  ∀ {a b : YoungCell μ}, T a = U b → TableauFilling.rowIndex a = TableauFilling.rowIndex b

/-- Row-content equivalence is reflexive for any bijective filling. -/
theorem rowContentEquivalent_refl {μ : YoungDiagram} (T : TableauFilling μ) :
    RowContentEquivalent T T := by
  intro a b h
  exact congrArg TableauFilling.rowIndex (T.bijective_entry.1 h)

/-- Row-content equivalence is symmetric. -/
theorem rowContentEquivalent_symm {μ : YoungDiagram} {T U : TableauFilling μ}
    (hTU : RowContentEquivalent T U) : RowContentEquivalent U T := by
  intro a b h
  exact (hTU (a := b) (b := a) h.symm).symm

/-- Row-content equivalence is transitive. -/
theorem rowContentEquivalent_trans {μ : YoungDiagram} {T U V : TableauFilling μ}
    (hTU : RowContentEquivalent T U) (hUV : RowContentEquivalent U V) :
    RowContentEquivalent T V := by
  intro a c hTV
  rcases U.bijective_entry.2 (T a) with ⟨b, hb⟩
  exact (hTU (a := a) (b := b) hb.symm).trans (hUV (a := b) (b := c) (hb.trans hTV))

/-- Setoid quotient relation for tabloids of a fixed shape. -/
def rowContentSetoid (μ : YoungDiagram) : Setoid (TableauFilling μ) where
  r := RowContentEquivalent
  iseqv := ⟨rowContentEquivalent_refl, @rowContentEquivalent_symm μ, @rowContentEquivalent_trans μ⟩

/-- Tabloids of shape `μ`, modeled as row-content classes of bijective fillings. -/
abbrev Tabloid (μ : YoungDiagram) : Type :=
  Quotient (rowContentSetoid μ)

/-- The tabloid underlying a standard tableau. -/
def StandardTableau.toTabloid {μ : YoungDiagram} (T : StandardTableau μ) : Tabloid μ :=
  Quotient.mk'' T.toTableauFilling

