/-- The canonical time axis for standard Brownian motion in this Stage1 boundary. -/
abbrev BrownianTime := ℝ≥0

/-- Real-valued stochastic process on a measurable probability space. -/
abbrev RealProcess (Ω : Type u) := BrownianTime → Ω → ℝ

/-- Variance parameter of the increment from `s` to `t`, assuming `s ≤ t`. -/
def incrementVariance (s t : BrownianTime) (hst : s ≤ t) : ℝ≥0 :=
  ⟨(t : ℝ) - (s : ℝ), sub_nonneg.mpr (by exact_mod_cast hst)⟩

/--
Standard Brownian/Wiener process properties over a fixed probability space.

The fields are deliberately statement-level:
* measurability of each coordinate random variable,
* standard Gaussian law for each ordered increment,
* Gaussian finite-dimensional distributions,
* independent increments,
* continuous sample paths,
* start at zero almost surely,
* adaptedness to the natural filtration generated by the process.
-/
structure WienerProcess (Ω : Type u) [MeasurableSpace Ω]
    (P : Measure Ω) (W : RealProcess Ω) : Prop where
  measurable : ∀ t : BrownianTime, Measurable (W t)
  increment_hasLaw :
    ∀ ⦃s t : BrownianTime⦄, (hst : s ≤ t) →
      HasLaw (fun ω ↦ W t ω - W s ω)
        (gaussianReal 0 (incrementVariance s t hst)) P
  gaussianProcess : IsGaussianProcess W P
  indepIncrements : HasIndepIncrements W P
  continuous_paths : ∀ᵐ ω ∂P, Continuous fun t : BrownianTime ↦ W t ω
  starts_at_zero : ∀ᵐ ω ∂P, W 0 ω = 0
  adapted_natural :
    Adapted (Filtration.natural W fun t ↦ (measurable t).stronglyMeasurable) W

/--
Normalized Stage1 statement-shape candidate for the existence of standard
Brownian motion.

This is a `Prop` boundary only: it states that some probability space carries a
process satisfying the usual Wiener-process axioms.  It is not marked as a
completed proof of existence in this repository.
-/
def StatementShape : Prop :=
  ∃ (Ω : Type u) (_ : MeasurableSpace Ω) (P : Measure Ω) (W : RealProcess Ω),
    IsProbabilityMeasure P ∧ WienerProcess Ω P W

/-- The statement shape exposes an explicitly probability-measured process. -/
theorem statementShape_intro
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : RealProcess Ω}
    (hP : IsProbabilityMeasure P) (hW : WienerProcess Ω P W) :
    StatementShape.{u} :=
  ⟨Ω, inferInstance, P, W, hP, hW⟩

/-- The ordered-increment variance agrees with truncated subtraction on `ℝ≥0`. -/
theorem incrementVariance_eq_tsub {s t : BrownianTime} (hst : s ≤ t) :
    incrementVariance s t hst = t - s := by
  apply NNReal.eq
  rw [NNReal.coe_sub hst]
  simp [incrementVariance]

/--
For ordered times, the local variance convention matches the symmetric variance
used by the external Brownian construction's subtraction-law theorem.
-/
theorem incrementVariance_eq_max_tsub {s t : BrownianTime} (hst : s ≤ t) :
    incrementVariance s t hst = max (t - s) (s - t) := by
  rw [max_eq_left]
  · exact incrementVariance_eq_tsub hst
  · rw [tsub_eq_zero_of_le hst]
    exact zero_le _

/-- A real random variable with law `gaussianReal 0 0` is zero almost surely. -/
theorem hasLaw_gaussianReal_zero_ae_eq_zero
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {X : Ω → ℝ}
    (hX : HasLaw X (gaussianReal 0 0) P) :
    ∀ᵐ ω ∂P, X ω = 0 := by
  refine (hX.ae_iff (p := fun x ↦ x = 0) (by fun_prop)).2 ?_
  rw [gaussianReal_zero_var]
  simp

/--
Bridge shape for the external `brownian-motion` component theorems.

Once `BrownianMotion.Gaussian.BrownianMotion` is available in the local Lake
closure, the external theorem `hasLaw_brownian_sub` has the symmetric
variance `max (s - t) (t - s)`.  This wrapper normalizes that convention to
the ordered increment law required by `WienerProcess`.
-/
theorem WienerProcess.of_externalBrownianComponents
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : RealProcess Ω}
    (h_meas : ∀ t : BrownianTime, Measurable (W t))
    (h_increment_abs :
      ∀ s t : BrownianTime,
        HasLaw (fun ω ↦ W s ω - W t ω)
          (gaussianReal 0 (max (s - t) (t - s))) P)
    (h_law_zero : HasLaw (W 0) (gaussianReal 0 0) P)
    (h_gaussian : IsGaussianProcess W P)
    (h_indep : HasIndepIncrements W P)
    (h_continuous_all : ∀ ω : Ω, Continuous fun t : BrownianTime ↦ W t ω) :
    WienerProcess Ω P W where
  measurable := h_meas
  increment_hasLaw := by
    intro s t hst
    simpa [incrementVariance_eq_max_tsub hst] using h_increment_abs t s
  gaussianProcess := h_gaussian
  indepIncrements := h_indep
  continuous_paths := Filter.Eventually.of_forall h_continuous_all
  starts_at_zero := hasLaw_gaussianReal_zero_ae_eq_zero h_law_zero
  adapted_natural :=
    (Filtration.stronglyAdapted_natural (u := W)
      (fun t ↦ (h_meas t).stronglyMeasurable)).adapted

/--
Statement-shape wrapper for the same external-component bridge.

This is not the terminal Brownian existence proof: it still requires the
external Brownian package to be pinned/imported and the component facts to be
instantiated with `ProbabilityTheory.brownian` and its canonical measure.
-/
theorem statementShape_of_externalBrownianComponents
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : RealProcess Ω}
    (hP : IsProbabilityMeasure P)
    (h_meas : ∀ t : BrownianTime, Measurable (W t))
    (h_increment_abs :
      ∀ s t : BrownianTime,
        HasLaw (fun ω ↦ W s ω - W t ω)
          (gaussianReal 0 (max (s - t) (t - s))) P)
    (h_law_zero : HasLaw (W 0) (gaussianReal 0 0) P)
    (h_gaussian : IsGaussianProcess W P)
    (h_indep : HasIndepIncrements W P)
    (h_continuous_all : ∀ ω : Ω, Continuous fun t : BrownianTime ↦ W t ω) :
    StatementShape.{u} :=
  statementShape_intro hP
    (WienerProcess.of_externalBrownianComponents
      h_meas h_increment_abs h_law_zero h_gaussian h_indep h_continuous_all)

/--
Checked mathlib anchor: a Gaussian process lives over a probability measure.
-/
theorem gaussianProcess_isProbabilityMeasure
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : RealProcess Ω}
    (hW : IsGaussianProcess W P) :
    IsProbabilityMeasure P :=
  hW.isProbabilityMeasure

/--
Checked mathlib anchor: each coordinate of a Gaussian process is a.e.
measurable.
-/
theorem gaussianProcess_aemeasurable_eval
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : RealProcess Ω}
    (hW : IsGaussianProcess W P) (t : BrownianTime) :
    AEMeasurable (W t) P :=
  hW.aemeasurable t

/--
Checked mathlib anchor: each coordinate of a real Gaussian process has a
Gaussian law.
-/
theorem gaussianProcess_hasGaussianLaw_eval
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : RealProcess Ω}
    (hW : IsGaussianProcess W P) (t : BrownianTime) :
    HasGaussianLaw (W t) P :=
  hW.hasGaussianLaw_eval t

/--
Checked mathlib anchor: finite ordered increments of a real Gaussian process
have a Gaussian law.
-/
theorem gaussianProcess_hasGaussianLaw_increments
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : RealProcess Ω}
    (hW : IsGaussianProcess W P) {n : ℕ} {t : Fin (n + 1) → BrownianTime} :
    HasGaussianLaw (fun ω (i : Fin n) ↦ W (t i.succ) ω - W (t i.castSucc) ω) P :=
  hW.hasGaussianLaw_increments

/--
Checked mathlib anchor: the general independent-increment predicate gives
independence of two adjacent increments.
-/
theorem indepIncrements_indepFun_sub_sub
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : RealProcess Ω}
    (hW : HasIndepIncrements W P) {r s t : BrownianTime}
    (hrs : r ≤ s) (hst : s ≤ t) :
    (W s - W r) ⟂ᵢ[P] (W t - W s) :=
  hW.indepFun_sub_sub hrs hst

/--
Checked mathlib anchor: the finite-dimensional formulation of independent
increments is equivalent to the monotone-sequence formulation.
-/
theorem hasIndepIncrements_iff_nat_wrapper
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : RealProcess Ω} :
    HasIndepIncrements W P ↔
      ∀ t : ℕ → BrownianTime, Monotone t →
        iIndepFun (fun i ω ↦ W (t (i + 1)) ω - W (t i) ω) P :=
  hasIndepIncrements_iff_nat

/--
Checked mathlib anchor: coordinate measurability plus the Kolmogorov moment
bound builds a `IsKolmogorovProcess` hypothesis object.
-/
theorem kolmogorovProcess_mk_of_secondCountableTopology
    {Ω : Type u} [MeasurableSpace Ω] {P : Measure Ω} {W : RealProcess Ω}
    {p q : ℝ} {M : ℝ≥0}
    (h_meas : ∀ s : BrownianTime, Measurable (W s))
    (h_kol :
      ∀ s t : BrownianTime,
        ∫⁻ ω, edist (W s ω) (W t ω) ^ p ∂P ≤ M * edist s t ^ q)
    (hp : 0 < p) (hq : 0 < q) :
    IsKolmogorovProcess W P p q M :=
  IsKolmogorovProcess.mk_of_secondCountableTopology h_meas h_kol hp hq

