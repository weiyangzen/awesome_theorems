/-!
# S1-M-077 / THM-M-0422

Stage1 statement-shape artifact for global class field theory over number fields.

mathlib currently supplies number fields, rings of integers, class groups, adeles,
abelian Galois extensions, and enough quotient-group infrastructure to define a
concrete multiplicative-ideles object as the unit group of the adele ring.  This
file records those checked anchors and keeps the terminal class-field-theory
correspondence as an explicit abstract boundary: finite abelian extensions of a
number field should correspond to open finite-index subgroups of the idele class
group, via a reciprocity map.
-/

open scoped NumberField

noncomputable section

namespace AwesomeTheorems.Stage1.S1_M_077

universe uK uL uC uE

/--
A finite abelian extension package over a base field `K`.

This uses mathlib's `IsAbelianGalois` class as the checked algebraic side of the
class-field-theory statement, while leaving the classification by idele-class
data to `ClassFieldReciprocityData` below.
-/
structure FiniteAbelianExtension (K : Type uK) [Field K] where
  L : Type uL
  [field : Field L]
  [algebra : Algebra K L]
  [finiteDimensional : FiniteDimensional K L]
  [isAbelianGalois : IsAbelianGalois K L]

attribute [instance] FiniteAbelianExtension.field
attribute [instance] FiniteAbelianExtension.algebra
attribute [instance] FiniteAbelianExtension.finiteDimensional
attribute [instance] FiniteAbelianExtension.isAbelianGalois

/-- The number-field adele ring currently supplied by mathlib. -/
abbrev NumberFieldAdeleRing (K : Type uK) [Field K] [NumberField K] :=
  NumberField.AdeleRing (𝓞 K) K

/--
Concrete multiplicative ideles available from pinned mathlib infrastructure.

This is the group of units of mathlib's number-field adele ring.  It is not a
global reciprocity map, but it removes the previous abstract `IdeleClassGroup`
field from the Stage1 object model.
-/
abbrev MultiplicativeIdeles (K : Type uK) [Field K] [NumberField K] :=
  Units (NumberFieldAdeleRing K)

/-- The diagonal homomorphism from `Kˣ` into the multiplicative ideles. -/
def principalIdeleHom
    (K : Type uK) [Field K] [NumberField K] :
    Kˣ →* MultiplicativeIdeles K :=
  Units.map (algebraMap K (NumberFieldAdeleRing K))

/-- The diagonal homomorphism into ideles is injective. -/
theorem principalIdeleHom_injective
    (K : Type uK) [Field K] [NumberField K] :
    Function.Injective (principalIdeleHom K) := by
  intro x y hxy
  apply Units.ext
  exact NumberField.AdeleRing.algebraMap_injective (𝓞 K) K (congrArg Units.val hxy)

/-- Principal ideles, as the subgroup generated by the diagonal image of `Kˣ`. -/
abbrev PrincipalIdeles (K : Type uK) [Field K] [NumberField K] :
    Subgroup (MultiplicativeIdeles K) :=
  MonoidHom.range (principalIdeleHom K)

/--
Concrete idele class group from pinned mathlib primitives: multiplicative
ideles modulo principal ideles.
-/
abbrev IdeleClassGroup (K : Type uK) [Field K] [NumberField K] :=
  MultiplicativeIdeles K ⧸ PrincipalIdeles K

/-- The quotient homomorphism from ideles to the idele class group. -/
def ideleClassQuotientHom
    (K : Type uK) [Field K] [NumberField K] :
    MultiplicativeIdeles K →* IdeleClassGroup K :=
  QuotientGroup.mk' (PrincipalIdeles K)

/-- The quotient homomorphism from ideles to the idele class group is surjective. -/
theorem ideleClassQuotientHom_surjective
    (K : Type uK) [Field K] [NumberField K] :
    Function.Surjective (ideleClassQuotientHom K) := by
  simpa [ideleClassQuotientHom] using
    (QuotientGroup.mk'_surjective (PrincipalIdeles K))

/-- The quotient homomorphism has kernel exactly the subgroup of principal ideles. -/
theorem ideleClassQuotientHom_ker
    (K : Type uK) [Field K] [NumberField K] :
    MonoidHom.ker (ideleClassQuotientHom K) = PrincipalIdeles K := by
  exact QuotientGroup.ker_mk' (PrincipalIdeles K)

/--
Open finite-index subgroups of the concrete idele class group.

The topology is mathlib's quotient topology on quotient groups.  The finite-index
condition uses mathlib's `Subgroup.FiniteIndex` class.
-/
structure OpenFiniteIndexIdeleClassSubgroup
    (K : Type uK) [Field K] [NumberField K] where
  carrier : Subgroup (IdeleClassGroup K)
  isOpen_carrier : IsOpen (carrier : Set (IdeleClassGroup K))
  finiteIndex_carrier : carrier.FiniteIndex

instance
    (K : Type uK) [Field K] [NumberField K] :
    Group (IdeleClassGroup K) := by
  infer_instance

instance
    (K : Type uK) [Field K] [NumberField K] :
    TopologicalSpace (IdeleClassGroup K) := by
  infer_instance

/--
Abstract data needed to state the global class field theory correspondence.

The idele class group itself is now concrete in this file.  The remaining
abstract boundary is the global Artin/reciprocity construction and the finite
abelian extension object classified by open finite-index subgroups.
-/
structure ClassFieldReciprocityData
    (K : Type uK) [Field K] [NumberField K] :
    Type (max (uK + 1) (max (uL + 1) (uE + 1))) where
  Extension : Type uE
  toFiniteAbelianExtension : Extension → FiniteAbelianExtension.{uK, uL} K
  reciprocityKernel : Extension → OpenFiniteIndexIdeleClassSubgroup K

/--
Statement-shape candidate for global class field theory.

For a number field `K`, finite abelian extensions are represented by
`data.Extension`, open finite-index subgroups use the concrete idele class group
`IdeleClassGroup K`, and `data.reciprocityKernel` is the kernel map coming from
global reciprocity.  The terminal theorem would replace `data.Extension` and
`data.reciprocityKernel` with a pinned Artin/global reciprocity construction and
prove the bijection.
-/
def StatementShape
    (K : Type uK) [Field K] [NumberField K]
    (data : ClassFieldReciprocityData.{uK, uL, uE} K) : Prop :=
  Function.Bijective data.reciprocityKernel

/-- Checked mathlib anchor: the class number is positive for every number field. -/
theorem numberFieldClassNumber_pos
    (K : Type uK) [Field K] [NumberField K] :
    0 < NumberField.classNumber K :=
  NumberField.classNumber_pos K

/--
Checked mathlib anchor: class number one is equivalent to the ring of integers
being a principal ideal ring.
-/
theorem numberFieldClassNumber_eq_one_iff_pid
    (K : Type uK) [Field K] [NumberField K] :
    NumberField.classNumber K = 1 ↔ IsPrincipalIdealRing (𝓞 K) :=
  NumberField.classNumber_eq_one_iff

/-- Checked mathlib anchor: the diagonal map from a number field into its adele ring is injective. -/
theorem adeleRing_algebraMap_injective
    (R : Type uC) (K : Type uK) [CommRing R] [IsDedekindDomain R]
    [Field K] [Algebra R K] [IsFractionRing R K] [NumberField K] :
    Function.Injective (algebraMap K (NumberField.AdeleRing R K)) :=
  NumberField.AdeleRing.algebraMap_injective R K

/-- Checked mathlib anchor: principal adeles are the additive range of the diagonal embedding. -/
theorem adeleRing_principalSubgroup_def
    (R : Type uC) (K : Type uK) [CommRing R] [IsDedekindDomain R]
    [Field K] [Algebra R K] [IsFractionRing R K] :
    NumberField.AdeleRing.principalSubgroup R K =
      (algebraMap K (NumberField.AdeleRing R K)).range.toAddSubgroup :=
  rfl

/-- Checked mathlib anchor: cyclic Galois extensions are abelian Galois extensions. -/
theorem isAbelianGalois_of_cyclic_galois
    (K : Type uK) (L : Type uL) [Field K] [Field L] [Algebra K L]
    [IsGalois K L] [IsCyclic Gal(L/K)] :
    IsAbelianGalois K L :=
  IsAbelianGalois.of_isCyclic K L

