/--
The diagonal map into multiplicative ideles is induced by the diagonal algebra
map into mathlib's adele ring.

This is the checked bridge from `NumberField.AdeleRing` to the repo-local
`MultiplicativeIdeles` object.  It does not identify the additive principal
adele subgroup with a multiplicative quotient.
-/
theorem principalIdeleHom_val
    (K : Type uK) [Field K] [NumberField K] (x : Kˣ) :
    ((principalIdeleHom K x : MultiplicativeIdeles K) : NumberFieldAdeleRing K) =
      algebraMap K (NumberFieldAdeleRing K) (x : K) := by
  rfl

/-- Membership in `PrincipalIdeles` is exactly membership in the diagonal image of `Kˣ`. -/
theorem mem_principalIdeles_iff
    (K : Type uK) [Field K] [NumberField K] (x : MultiplicativeIdeles K) :
    x ∈ PrincipalIdeles K ↔ ∃ y : Kˣ, principalIdeleHom K y = x := by
  rfl

